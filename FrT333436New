      reportId: reportId.toString(),
      qed: userInfo.quarterEndDate,
    };
    try {
      const response = await callApi('/frReturn/submitIndividual', params, 'POST');
      if (response === 1) {
        setIsSuccessDialogVisible(true);
      } else {
        snackbar(`Failed to submit ${subReportName}!`, 'error');
      }
    } catch (error) {
      if (error.code === 'ERR_CANCELED') {
        return;
      }
