const validateAndFormatAmount = (value) => {
  if (value === null || value === undefined) value = '';
  let amt = String(value).replace(/ /g, '');

  if (isNaN(amt)) {
    return { isValid: false, value: '', error: 'Please enter a numeric value only.' };
  }

  const pattern = /^(?:\-?\d{1,15}\.\d{1,2}|\-?\d{1,15})$/;
  if (!pattern.test(amt) && amt !== '') {
    return { isValid: false, value, error: 'Amount cannot exceed 15 digits before and 2 digits after the decimal.' };
  }

  // Format to two decimal places on blur
  if (amt.includes('.')) {
    const parts = amt.split('.');
    amt = `${parts[0]}.${parts[1].padEnd(2, '0')}`;
  } else if (amt !== '') {
    amt = `${amt}.00`;
  }

  return { isValid: true, value: amt, error: '' };
};

const CommonFRAddRow = () => {
  const navigate = useNavigate();
  const snackbar = useCustomSnackbar();
  const { callApi } = useApi();
  const userInfo = JSON.parse(localStorage.getItem('user'));
  const { state } = useLocation();
  const report = state?.report;

  const {
    subReportFR_RMID: rMId,
    subReportName,
    subReportFR_RPT_DATATBL: tableName,
    subReportFR_RID: initialReportId,
    subReportStatus: status,
  } = report || {};

  const [rows, setRows] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [reportId, setReportId] = useState(initialReportId);
  const [isSuccessDialogVisible, setIsSuccessDialogVisible] = useState(false);

  const initializeAndFetchData = useCallback(async () => {
    setIsLoading(true);
    let currentReportId = reportId;

    try {
      if (!status || status.length === 0) {
        const insertParams = {
          qed: userInfo.quarterEndDate,
          userId: userInfo.userId,
          tableName: tableName,
          rMId: rMId,
        };
        const newReportId = await callApi('/frAddRow/insertOnLoad', insertParams, 'POST');

        if (!newReportId) {
          throw new Error('Failed to create new report entry.');
        }
        if (typeof newReportId === 'string' && newReportId.includes('Report ID not generated')) {
          console.log('Report ID generation failed');
          snackbar('Error Loading the Data! Reopen this report from worklist again.', 'error');
          navigate(-1);
        }

        setReportId(newReportId);
        currentReportId = newReportId; // Use the new ID for the subsequent fetch
      }

      // Proceeding to fetch screen parameters
      if (!currentReportId) {
        throw new Error('Report ID is missing, cannot fetch data.');
      }

      const fetchParams = {
        qed: userInfo.quarterEndDate,
        userId: userInfo.userId,
        reportId: currentReportId.toString(),
        tableName: tableName,
      };
      const data = await callApi('/frAddRow/getScreenParam', fetchParams, 'POST');

      if (data) {
        setRows(data.map((row) => ({ ...row, isEditing: false, error: '' })));
      } else {
        throw new Error('Failed to fetch screen data.');
      }
    } catch (error) {
      if (error.code !== 'ERR_CANCELED') {
        console.log('Initialization Fails', error.message);
        snackbar(error.message, 'error');
      }
    } finally {
      setIsLoading(false);
    }
  }, [reportId, status, tableName, rMId, userInfo, snackbar]);

  useEffect(() => {
    if (!tableName || !rMId) {
      snackbar('Required report details are missing.', 'warning');
      navigate(-1);
      return;
    }
    initializeAndFetchData();
  }, []);

  const handleInputChange = (e, index, field) => {
    const newRows = [...rows];
    newRows[index][field] = e.target.value;
    if (field === 'CY') {
      newRows[index].error = '';
    }
    setRows(newRows);
  };

  const handleAmountBlur = (index) => {
    const row = rows[index];
    const { isValid, value, error } = validateAndFormatAmount(row.CY);
    const newRows = [...rows];
    newRows[index].CY = value;
    newRows[index].error = error;
    setRows(newRows);
  };

  const handleEditRow = (index) => {
    const newRows = [...rows];
    newRows[index].isEditing = true;
    console.log('Edit row clicked : ', newRows);
    setRows(newRows);
  };

  const handleAddRow = useCallback(() => {
    setRows((prevRows) => [
      ...prevRows,
      {
        id: 0,
        DESCE: '',
        CY: '',
        editable: 'Y',
        isEditing: true,
        error: '',
      },
    ]);
  }, []);

  const handleSaveRow = useCallback(
    async (index) => {
      const row = rows[index];
      if (row.CY.trim() === '' && row.DESCE.trim() === '') {
        snackbar('Please enter some data to save row.', 'error');
        return;
      }

      // Final validation before saving
      const validation = validateAndFormatAmount(row.CY);
      if (!validation.isValid) {
        snackbar(validation.error, 'error');
        const newRows = [...rows];
        newRows[index].error = validation.error;
        setRows(newRows);
        return;
      }

      const isNewRow = row.id === 0;
      const url = isNewRow ? '/frAddRow/saveRow' : '/frAddRow/editRow';

      const payload = {
        reportId: reportId.toString(),
        id: row.id.toString(),
        tableName: tableName.toString(),
        qed: userInfo.quarterEndDate.toString(),
        desc: row.DESCE.toString(),
        cy: validation.value, // formatted value
      };

      try {
        const response = await callApi(url, payload, 'POST');
        if (response) {
          const newRows = [...rows];
          const updatedRow = { ...newRows[index], isEditing: false, CY: validation.value };
          if (isNewRow) {
            updatedRow.id = response;
          }
          newRows[index] = updatedRow;
          setRows(newRows);
          snackbar('Row saved successfully!', 'success');
        } else {
          throw new Error(response || 'Failed to save row.');
        }
      } catch (error) {
        console.log('Error in save row : ', error.message);
        snackbar(error.message, 'error');
      }
    },
    [rows, reportId, tableName, userInfo, snackbar]
  );

  const handleDeleteRow = useCallback(
    async (index) => {
      const row = rows[index];
      if (row.id === 0) {
        // If row is not saved yet
        console.log('removed unsaved new row : ', row);
        setRows((prevRows) => prevRows.filter((_, i) => i !== index));
        return;
      }

      const params = {
        reportId,
        tableName,
        id: row.id,
        qed: userInfo.quarterEndDate,
        desc: row.DESCE,
        cy: row.CY,
      };

      try {
        const response = await callApi('/frAddRow/deleteRow', params, 'POST');
        if (response === 1) {
          setRows((prevRows) => prevRows.filter((_, i) => i !== index));
          snackbar('Row deleted successfully!', 'warning');
        } else {
          const data = await response.json();
          throw new Error(data.message || 'Failed to delete row.');
        }
      } catch (error) {
        console.log('Delete failed : ', error);
        snackbar(error.message, 'error');
      }
    },
    [rows, reportId, tableName, userInfo, snackbar]
  );

