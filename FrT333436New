      snackbar(`Failed to submit ${subReportName}!`, 'error');
    } finally {
      setIsSubmitting(false);
    }
  }, [reportId, userInfo, snackbar]);

  const handleSuccessDialogClose = useCallback(() => {
    setIsSuccessDialogVisible(false);
    navigate('../');
  }, [navigate]);

  if (isLoading) {
    return (
      <Container sx={{ display: 'flex', justifyContent: 'center', mt: 5 }}>
        <CircularProgress />
      </Container>
    );
  }

  return (
    <Box>
      <Box sx={{ display: 'flex', gap: 1, justifyContent: 'left' }}>
        <CustomButton label={'Add Row'} buttonType={'create'} onClickHandler={handleAddRow} disabled={isLoading} />
        <CustomButton
          buttonType={'submit'}
          label={'Complete'}
          disabled={isSubmitting || rows.some((r) => r.isEditing) || isLoading}
          onClickHandler={handleSubmit}
        />
      </Box>

      <Box component={Paper} elevation={3} sx={{ mt: 1 }}>
        <TableContainer component={Paper} sx={{ maxHeight: 650 }}>
          <Table stickyHeader aria-label="sticky table">
            <TableHead>
              <TableRow sx={{ '& th': { fontWeight: 'bold' } }}>
                <TableCell align="center">Particulars</TableCell>
                <TableCell align="center">Current Year</TableCell>
                <TableCell align="center" sx={{ width: '180px' }}>
                  Action
                </TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {rows.map((row, index) => (
                <TableRow key={row.id || `new-${index}`} hover>
                  <TableCell>
                    <FormInput
                      fullWidth
                      inputType={'text'}
                      value={row.DESCE || ''}
                      onChange={(e) => handleInputChange(e, index, 'DESCE')}
                      onBlur={() => handleAmountBlur(index)}
                      readOnly={!row.isEditing || row.editable === 'N'}
                      debounceDuration={1}
                      maxLength={250}
                      inputProps={{ id: `val${index}` }}
                    />
                  </TableCell>

                  <TableCell>
                    <FormInput
                      fullWidth
                      inputType={'wholeAmountDecimal'}
                      value={row.CY || '0'}
                      onChange={(e) => handleInputChange(e, index, 'CY')}
                      onBlur={() => handleAmountBlur(index)}
                      readOnly={!row.isEditing}
                      placeholder={'Enter value'}
                      debounceDuration={1}
                      error={!!row.error}
                      helperText={row.error}
                      inputProps={{ id: `val${index}` }}
                    />
                  </TableCell>

                  <TableCell align="center">
                    <Stack direction={'row'} sx={{ display: 'flex', justifyContent: 'center', gap: 1 }}>
                      {row.isEditing ? (
                        <CustomButton
                          onClickHandler={() => handleSaveRow(index)}
                          buttonType={'save'}
                          onlyIconButton={true}
                          label={'Save this row'}
                        />
                      ) : (
                        <CustomButton
                          onClickHandler={() => handleEditRow(index)}
                          buttonType={'edit'}
                          onlyIconButton={true}
                          label={'Edit this row'}
                        />
                      )}
                      <CustomButton
                        onClickHandler={() => handleDeleteRow(index)}
                        buttonType={'delete'}
                        onlyIconButton={true}
                        disabled={row.editable === 'N'}
                        label={'Delete this row'}
                      />
                    </Stack>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </TableContainer>
      </Box>

      <ActionResultDialog
        open={isSuccessDialogVisible}
        onClose={handleSuccessDialogClose}
        message={`${subReportName} report has been submitted succesfully!`}
      />
    </Box>
  );
};

export default CommonFRAddRow;















