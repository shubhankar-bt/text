package com.tcs.f1.cglservice.controller;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.f1.cglservice.dto.*;
import com.tcs.f1.cglservice.mapper.CommonReqMapper;
import com.tcs.f1.cglservice.model.CommonReq;
import com.tcs.f1.cglservice.service.RequestService;
import com.tcs.f1.security.util.JwtUtil;
import jakarta.validation.ConstraintViolation;
import jakarta.validation.ConstraintViolationException;
import jakarta.validation.Valid;
import jakarta.validation.Validator;
import lombok.RequiredArgsConstructor;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Set;
import java.util.stream.Collectors;

@RestController
@RequestMapping("/api/v1/requests")
@RequiredArgsConstructor
public class RequestController {

    private final RequestService requestService;
    private final CommonReqMapper commonReqMapper;
    private final ObjectMapper objectMapper;
    private final Validator validator;

    @PostMapping
    @ResponseStatus(HttpStatus.CREATED)
    public CommonReqResponseDto createRequest(@Valid @RequestBody CreateRequestDto createRequestDto) throws JsonProcessingException {
        // --- THIS IS THE NEW, SIMPLIFIED LOGIC ---

        // 1. Manually convert the generic payload to the specific DTO based on requestType
        Object validatedPayload;
        switch (createRequestDto.getRequestType()) {
            case SEGMENT_CODE:
                validatedPayload = objectMapper.treeToValue(createRequestDto.getPayload(), SegmentPayloadDto.class);
                break;
            case CGL_CODE:
                validatedPayload = objectMapper.treeToValue(createRequestDto.getPayload(), CglPayloadDto.class);
                break;
            default:
                throw new IllegalArgumentException("Unsupported request type: " + createRequestDto.getRequestType());
        }

        // 2. Manually trigger validation on the newly created specific DTO
        Set<ConstraintViolation<Object>> violations = validator.validate(validatedPayload);
        if (!violations.isEmpty()) {
            // If validation fails, throw a clear exception
            throw new ConstraintViolationException("Payload validation failed", violations);
        }

        // 3. The payload is valid. Proceed to call the service.
        String userId = JwtUtil.getUserIdFromContext();
        String payloadAsString = objectMapper.writeValueAsString(validatedPayload);

        CommonReq createdRequest = requestService.createRequest(createRequestDto, payloadAsString, userId);
        return commonReqMapper.toDto(createdRequest);
    }
    
    // ... all other controller methods remain the same ...

    @PatchMapping("/status")
    public CommonReqResponseDto updateRequestStatus(@Valid @RequestBody ProcessRequestDto processRequestDto) throws JsonProcessingException {
        String executorId = JwtUtil.getUserIdFromContext();
        return requestService.updateRequestStatus(processRequestDto, executorId)
                .map(commonReqMapper::toDto)
                .orElseThrow(() -> new RuntimeException("Could not update request status."));
    }

    @PostMapping("/my-requests")
    public List<CommonReqResponseDto> getMyRequests(@RequestBody MyRequestsFilterDto filterDto) {
        String userId = JwtUtil.getUserIdFromContext();
        return requestService.getMyRequests(userId, filterDto.getRequestType())
                .stream()
                .map(commonReqMapper::toDto)
                .collect(Collectors.toList());
    }

    @GetMapping("/pending")
    public List<CommonReqResponseDto> getPendingRequests() {
        return requestService.getPendingRequests()
                .stream()
                .map(commonReqMapper::toDto)
                .collect(Collectors.toList());
    }

    @GetMapping
    public List<CommonReqResponseDto> getAllRequests() {
        return requestService.getAllRequests()
                .stream()
                .map(commonReqMapper::toDto)
                .collect(Collectors.toList());
    }
}












