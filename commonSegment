package com.tcs.f1.cglservice.service;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.f1.cglservice.model.CommonReq;
import com.tcs.f1.cglservice.model.SegmentCodeMaster;
import com.tcs.f1.cglservice.repository.CommonRequestRepository;
import com.tcs.f1.cglservice.repository.SegmentCodeMasterRepository;
import jakarta.transaction.Transactional;
import org.springframework.stereotype.Service;

import java.time.LocalDate;
import java.util.List;
import java.util.Optional;

@Service
public class SegmentRequestServiceImpl implements SegmentRequestService {

    private final CommonRequestRepository commonRequestRepository;
    private final SegmentCodeMasterRepository segmentCodeMasterRepository;

    private final ObjectMapper mapper;

    public SegmentRequestServiceImpl(CommonRequestRepository commonRequestRepository, SegmentCodeMasterRepository segmentCodeMasterRepository, ObjectMapper mapper) {
        this.commonRequestRepository = commonRequestRepository;
        this.segmentCodeMasterRepository = segmentCodeMasterRepository;
        this.mapper = mapper;
    }

    @Override
    public List<CommonReq> getMySegmentRequests(String userId) {
        return commonRequestRepository.getMySegmentRequests(userId);
    }

    @Override
    public List<CommonReq> getSegmentRequestsForExecutor() {
        return commonRequestRepository.getSegmentRequestsForExecutor();
    }

    @Override
    public CommonReq postSegmentReqCode(CommonReq commonReq) {

        return commonRequestRepository.save(commonReq);
    }

    @Transactional
    @Override
    public CommonReq patchSegmentReqCode(CommonReq commonReq) throws JsonProcessingException {
        String executorId = "1234567"; //todo user id must be fetched from jwt token
        Optional<CommonReq> existingSegmentOptional = commonRequestRepository.findById(commonReq.getId());

        if (existingSegmentOptional.isPresent()) {
            CommonReq existingCommonRequest = existingSegmentOptional.get();

            if (existingCommonRequest.getReqStatus() != null) {
                existingCommonRequest.setReqStatus(existingCommonRequest.getReqStatus());
            }
            if (existingCommonRequest.getExecutorRemarks() != null) {
                existingCommonRequest.setExecutorRemarks(existingCommonRequest.getExecutorRemarks());
            }
            if (existingCommonRequest.getReqStatus() != null && existingCommonRequest.getReqStatus().equals("A")) {
                String payloadJson = commonReq.getPayload();
                SegmentCodeMaster segmentCodeMaster = mapper.readValue(payloadJson, SegmentCodeMaster.class);

                try {
                    segmentCodeMasterRepository.save(segmentCodeMaster);
                    existingCommonRequest.setExecutionDate(LocalDate.now());
                    existingCommonRequest.setExecutionRemarks("Request Accepted.");
                    existingCommonRequest.setExecutorId(executorId);
                } catch (Exception e) {
                    existingCommonRequest.setReqStatus("P");
                }
            }
            return commonRequestRepository.save(existingCommonRequest);
        }
        return null;
    }
}


























