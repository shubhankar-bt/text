package com.tcs.f1.cglservice.controller;

import com.tcs.f1.cglservice.model.CommonReq;
import com.tcs.f1.cglservice.service.SegmentRequestService;
import lombok.extern.slf4j.Slf4j;
import org.springframework.dao.DataIntegrityViolationException;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@Slf4j
@RestController
public class SegmentRequestController {

    private final SegmentRequestService segmentRequestService;

    public SegmentRequestController(SegmentRequestService segmentRequestService) {
        this.segmentRequestService = segmentRequestService;
    }

    @GetMapping("/segment-requests")
    public ResponseEntity<List<CommonReq>> getSegmentRequests(@RequestHeader("Authorization") String authorizationHeader) {
        try {
            if (authorizationHeader != null && authorizationHeader.startsWith("Bearer ")) {
                String jwtToken = authorizationHeader.substring(7);
                // todo assuming jwt decrypted
//                int userRole = jwtToken.userRole;
//                String userId = jwtToken.userId;
                int userRole = 51;
                String userId = "1234567";
                List<CommonReq> cgls = userRole == 51 ? segmentRequestService.getMySegmentRequests(userId) : segmentRequestService.getSegmentRequestsForExecutor();
                return ResponseEntity.ok(cgls);
            } else {
                return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build();
            }
        } catch (Exception e) {
            log.error("Error getting the SegmentRequests!\n{}", e.getMessage());
            return ResponseEntity.internalServerError().build();
        }
    }

    @PostMapping("/segment-requests")
    public ResponseEntity<CommonReq> postSegmentRequest(@RequestBody CommonReq commonReq) {
        try {
            CommonReq reqResponse = segmentRequestService.postSegmentReqCode(commonReq);
            return ResponseEntity.ok(reqResponse);
        } catch (DataIntegrityViolationException e) {
            log.error("Error posting the segment code request: DataIntegrityViolationException!\n{}", e.getMessage());
            return ResponseEntity.status(HttpStatus.CONFLICT).build();
        } catch (Exception e) {
            log.error("Error posting the Segment!\n{}", e.getClass());
        }
        return ResponseEntity.internalServerError().build();
    }

    @PatchMapping("/segment-request")
    public ResponseEntity<CommonReq> patchSegmentReqCode(@RequestBody CommonReq commonReq) {
        try {
            CommonReq patchResponse = segmentRequestService.patchSegmentReqCode(commonReq);
            if (patchResponse == null) {
                return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
            } else {
                return ResponseEntity.ok(patchResponse);
            }
        } catch (DataIntegrityViolationException e) {
            log.error("Error patching the CGL: DataIntegrityViolationException!\n{}", e.getMessage());
            return ResponseEntity.status(HttpStatus.CONFLICT).build();
        } catch (Exception e) {
            log.error("Error patching the CGL!\n{}", e.getClass());
        }
        return ResponseEntity.internalServerError().build();
    }
}




























