package com.tcs.f1.cglservice.service;

import com.tcs.f1.cglservice.model.CGLMaster;
import com.tcs.f1.cglservice.repository.CGLMasterRepository;
import org.springframework.stereotype.Service;

import java.time.LocalDate;
import java.util.List;
import java.util.Optional;

@Service
public class CGLServiceImpl implements CGLService {

    private final CGLMasterRepository repository;

    public CGLServiceImpl(CGLMasterRepository repository) {
        this.repository = repository;
    }

    @Override
    public List<CGLMaster> getCGLs() {
        return (List<CGLMaster>) repository.findAll();
    }

    @Override
    public CGLMaster postCGL(CGLMaster cglMaster) {
        return repository.save(cglMaster);
    }

    @Override
    public CGLMaster patchCGL(CGLMaster cglMaster) {
        Optional<CGLMaster> existingCGLOptional = repository.findById(cglMaster.getCglNumber());
        if (existingCGLOptional.isPresent()) {
            CGLMaster existingCGL = existingCGLOptional.get();
            if (cglMaster.getDescription() != null) {
                existingCGL.setDescription(cglMaster.getDescription());
            }
            if (cglMaster.getAcClassification() != null) {
                existingCGL.setAcClassification(cglMaster.getAcClassification());
            }
            if (cglMaster.getBalFwd() != null) {
                existingCGL.setBalFwd(cglMaster.getBalFwd());
            }
            if (cglMaster.getDefBalType() != null) {
                existingCGL.setDefBalType(cglMaster.getDefBalType());
            }
            if (cglMaster.getStatus() != null) {
                existingCGL.setStatus(cglMaster.getStatus());
                existingCGL.setCloseDate(cglMaster.getStatus() == 1 ? null : LocalDate.now());
            }
            if (cglMaster.getBalCompare() != null) {
                existingCGL.setBalCompare(cglMaster.getBalCompare());
            }
            if (cglMaster.getManualPosting() != null) {
                existingCGL.setManualPosting(cglMaster.getManualPosting());
            }
            return repository.save(existingCGL);
        } else {
            return null;
        }
    }
}

















