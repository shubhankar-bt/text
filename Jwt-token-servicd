package com.tcs.f1.security.util;

import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.server.resource.authentication.JwtAuthenticationToken;

/**
 * Production-ready utility to extract information from the validated and authenticated JWT
 * stored in Spring's SecurityContext.
 */
public class JwtUtil {

    /**
     * Safely retrieves the user ID (the 'sub' claim) from the authenticated principal.
     * This method should only be called from within a secured endpoint.
     *
     * @return The user ID string.
     * @throws IllegalStateException if the security context does not contain a valid JWT.
     */
    public static String getUserIdFromContext() {
        Object principal = SecurityContextHolder.getContext().getAuthentication().getPrincipal();

        if (principal instanceof Jwt) {
            return ((Jwt) principal).getSubject();
        }

        // This fallback can be useful if the token type is slightly different
        if (SecurityContextHolder.getContext().getAuthentication() instanceof JwtAuthenticationToken) {
            return ((JwtAuthenticationToken) SecurityContextHolder.getContext().getAuthentication()).getToken().getSubject();
        }

        throw new IllegalStateException("Could not extract user ID. The principal in the SecurityContext is not a valid JWT.");
    }
}












