package com.tcs.f1.security.util;

import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.security.oauth2.jwt.Jwt;

/**
 * A robust utility to extract information from the validated security context.
 */
public class JwtUtil {

    /**
     * Safely retrieves the user ID (the 'sub' claim) from the
     * authenticated principal in the SecurityContext.
     * @return The user ID string.
     * @throws IllegalStateException if the principal is not a JWT.
     */
    public static String getUserIdFromContext() {
        Object principal = SecurityContextHolder.getContext().getAuthentication().getPrincipal();
        if (principal instanceof Jwt) {
            return ((Jwt) principal).getSubject();
        }
        // This should not happen in a properly configured system
        throw new IllegalStateException("Could not extract user ID. Principal is not a JWT.");
    }
}










