package com.tcs.f1.cglservice.controller;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.tcs.f1.cglservice.dto.*;
import com.tcs.f1.cglservice.model.CommonReq;
import com.tcs.f1.cglservice.service.RequestService;
import com.tcs.f1.security.util.JwtUtil; // Import from the shared library
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/v1/requests")
@RequiredArgsConstructor
public class RequestController {

    private final RequestService requestService;

    /**
     * Endpoint for a MAKER to create a new request.
     * The user ID is securely retrieved from the validated JWT in the Security Context.
     */
    @PostMapping
    @ResponseStatus(HttpStatus.CREATED)
    public CommonReq createRequest(@Valid @RequestBody CreateRequestDto createRequestDto) throws JsonProcessingException {
        String userId = JwtUtil.getUserIdFromContext();
        return requestService.createRequest(createRequestDto, userId);
    }

    /**
     * Endpoint for a CHECKER to process (approve/reject) a request.
     * The executor ID is securely retrieved from the validated JWT.
     */
    @PatchMapping("/status")
    public CommonReq processRequest(@Valid @RequestBody ProcessRequestDto processRequestDto) throws JsonProcessingException {
        String executorId = JwtUtil.getUserIdFromContext();
        return requestService.updateRequestStatus(processRequestDto, executorId)
                .orElseThrow(() -> new RuntimeException("Could not process request."));
    }

    /**
     * Endpoint for a MAKER to fetch their own requests, with optional filtering.
     */
    @PostMapping("/my-requests")
    public List<CommonReq> getMyRequests(@RequestBody MyRequestsFilterDto filterDto) {
        String userId = JwtUtil.getUserIdFromContext();
        return requestService.getMyRequests(userId, filterDto.getRequestType());
    }

    /**
     * Endpoint for a CHECKER to see all requests pending their action.
     */
    @GetMapping("/pending")
    public List<CommonReq> getPendingRequests() {
        return requestService.getPendingRequests();
    }
}














