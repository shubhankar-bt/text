        function Checkwatch(numVal) {
            var no = (numVal.substring(4));
            if(numVal.contains('CDCY')){
                var ID='CDCY';
            }else if(numVal.contains('IDCY')){
                var ID='IDCY';
            }

            if (no == "2") {
                document.getElementById(ID+'1').value= (parseFloat(document.getElementById(ID+'1').value) - parseFloat(document.getElementById(numVal).value) + parseFloat(document.getElementById(ID+(parseInt(no)+1).toString()).value)).toFixed(2);
            } else if (no == "3") {
                document.getElementById(ID+'1').value= (parseFloat(document.getElementById(ID+'1').value) - parseFloat(document.getElementById(numVal).value) + parseFloat(document.getElementById(ID+(parseInt(no)-1).toString()).value)).toFixed(2);
            }else if (no == "5") {
                document.getElementById(ID+'4').value= (parseFloat(document.getElementById(ID+'4').value) - parseFloat(document.getElementById(numVal).value) - parseFloat(document.getElementById(ID+(parseInt(no)+1).toString()).value)).toFixed(2);
            } else if (no == "6") {
                document.getElementById(ID+'4').value= (parseFloat(document.getElementById(ID+'4').value) + parseFloat(document.getElementById(numVal).value) + parseFloat(document.getElementById(ID+(parseInt(no)-1).toString()).value)).toFixed(2);
            } else if (no == "9") {
                document.getElementById(ID+'8').value= (parseFloat(document.getElementById(ID+'8').value) - parseFloat(document.getElementById(numVal).value) + parseFloat(document.getElementById(ID+(parseInt(no)+1).toString()).value)).toFixed(2);
            } else if (no == "10") {
                document.getElementById(ID+'8').value= (parseFloat(document.getElementById(ID+'8').value) - parseFloat(document.getElementById(numVal).value) + parseFloat(document.getElementById(ID+(parseInt(no)-1).toString()).value)).toFixed(2);
            } else if (no == "12" ) {
                document.getElementById(ID+'11').value= (parseFloat(document.getElementById(ID+'11').value) - parseFloat(document.getElementById(numVal).value) + parseFloat(document.getElementById(ID+(parseInt(no)+1).toString()).value)).toFixed(2);
            } else if (no == "13") {
                document.getElementById(ID+'11').value= (parseFloat(document.getElementById(ID+'11').value) - parseFloat(document.getElementById(numVal).value) + parseFloat(document.getElementById(ID+(parseInt(no)-1).toString()).value)).toFixed(2);
            } else if (no == "15") {
                document.getElementById(ID+'14').value= (parseFloat(document.getElementById(ID+'14').value) - parseFloat(document.getElementById(numVal).value) + parseFloat(document.getElementById(ID+(parseInt(no)+1).toString()).value)).toFixed(2);
            }else if (no == "16") {
                document.getElementById(ID+'14').value= (parseFloat(document.getElementById(ID+'14').value) - parseFloat(document.getElementById(numVal).value) + parseFloat(document.getElementById(ID+(parseInt(no)-1).toString()).value)).toFixed(2);
            }
        }

        function checkAmount38(numVal){
            let amt = String(document.getElementById(numVal).value);
            amt=document.getElementById(numVal).value=amt.trim();
            if(amt != 0 || amt != 0.00){
                amt=amt.replace(/^0+/, "");
            }

            if (isNaN(amt)) {
                alert("Please enter Numeric Value only");
                document.getElementById(numVal).value = "";
                document.getElementById(numVal).focus();
                return false;
            }
            let c = /^(?:\-?\d{1,15}\.\d{1,2}|\-?\d{1,15})$/;
            if (c.test(amt) || amt === "") {
                let idot = amt.indexOf('.');
                if(idot === -1 ){
                    if(amt === ""){
                        document.getElementById(numVal).value = amt.concat("0.00");
                    }
                    else if((numVal=="val2") || (numVal=="val4") || (numVal=="val7")){
                        document.getElementById(numVal).value = Math.trunc(document.getElementById(numVal).value);
                    }else {
                        document.getElementById(numVal).value = amt.concat(".00");
                    }
                }  else if((numVal=="val2") || (numVal=="val4") || (numVal=="val7")){
                    document.getElementById(numVal).value = Math.trunc(document.getElementById(numVal).value);
                }
                else if(idot !== -1 && amt.charAt(idot+2) === "" ){
                    document.getElementById(numVal).value = amt.concat("0");
                }
            }else if(amt.length != 0) {
                alert("Amount is not allowed more than 15 digits and two decimal digits.");
                Checkwatch(numVal);
                document.getElementById(numVal).value = "";
                document.getElementById(numVal).focus();
                return false;
            }

            return true;
        }

