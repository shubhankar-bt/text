// --- Helper Functions ---

/**
 * Parses a string value (which may contain commas) to a number.
 * Returns 0 if the value is invalid or empty.
 * @param {string | number} value The value to parse.
 * @returns {number} The parsed number.
 */
const parseToNumber = (value) => {
  if (value === null || typeof value === 'undefined') return 0;
  const num = parseFloat(String(value).replace(/,/g, ''));
  return isNaN(num) ? 0 : num;
};

/**
 * Validates and formats a number input according to the legacy rules.
 * @param {string} value The input value.
 * @returns {{isValid: boolean, value: string, error: string | null}}
 */
const validateAndFormatAmount = (value) => {
  const trimmedValue = String(value).trim();
  if (trimmedValue === '' || trimmedValue === '0' || trimmedValue === '0.00') {
    return { isValid: true, value: '0.00', error: null };
  }
  // Regex to validate up to 15 digits before the decimal and 2 after.
  const regex = /^(?:\-?\d{1,15}\.\d{1,2}|\-?\d{1,15})$/;
  if (!regex.test(trimmedValue)) {
    return {
      isValid: false,
      value,
      error: 'Amount cannot exceed 15 digits before the decimal and 2 digits after.',
    };
  }

  let formattedValue = trimmedValue;
  if (!formattedValue.includes('.')) {
    formattedValue += '.00';
  } else if (formattedValue.split('.')[1].length === 1) {
    formattedValue += '0';
  }
  return { isValid: true, value: formattedValue, error: null };
};

