     */
    @GetMapping("/pending")
    public ResponseEntity<List<CommonReq>> getPendingRequests(@RequestHeader("Authorization") String authorizationHeader) {
        // Here you could add role-based authorization checks
        return ResponseEntity.ok(requestService.getPendingRequests());
