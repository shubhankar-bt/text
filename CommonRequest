     * Endpoint for a Maker to create a new request.
     */
    @PostMapping
    public ResponseEntity<CommonReq> createRequest(@RequestBody CreateRequestDto createRequestDto, @RequestHeader("Authorization") String authorizationHeader) throws JsonProcessingException {
        String userId = getUserIdFromToken(authorizationHeader);
