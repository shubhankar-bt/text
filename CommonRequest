package com.tcs.f1.cglservice.controller;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.tcs.f1.cglservice.dto.CreateRequestDto;
import com.tcs.f1.cglservice.dto.UpdateRequestStatusDto;
import com.tcs.f1.cglservice.model.CommonReq;
import com.tcs.f1.cglservice.service.RequestService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/v1/requests")
@RequiredArgsConstructor
@Slf4j
public class RequestController {

    private final RequestService requestService;

    // A mock function to get user info from token. Replace with your actual implementation.
    private String getUserIdFromToken(String authorizationHeader) {
        // In a real app, you would decode the JWT and get the user ID
        return "user123"; // MOCK USER ID
    }
    private int getUserRoleFromToken(String authorizationHeader) {
       // In a real app, you would decode the JWT and get the user role
        return 51; // MOCK MAKER ROLE
    }


    /**
     * Endpoint for a Maker to create a new request.
     */
    @PostMapping
    public ResponseEntity<CommonReq> createRequest(@RequestBody CreateRequestDto createRequestDto, @RequestHeader("Authorization") String authorizationHeader) throws JsonProcessingException {
        String userId = getUserIdFromToken(authorizationHeader);
        log.info("Received request creation call from user: {}", userId);
        CommonReq createdRequest = requestService.createRequest(createRequestDto, userId);
        return new ResponseEntity<>(createdRequest, HttpStatus.CREATED);
    }

    /**
     * Endpoint for a Maker to view their own requests.
     */
    @GetMapping("/my-requests")
    public ResponseEntity<List<CommonReq>> getMyRequests(@RequestHeader("Authorization") String authorizationHeader) {
        String userId = getUserIdFromToken(authorizationHeader);
        return ResponseEntity.ok(requestService.getMyRequests(userId));
    }

    /**
     * Endpoint for a Checker to see all pending requests.
     */
    @GetMapping("/pending")
    public ResponseEntity<List<CommonReq>> getPendingRequests(@RequestHeader("Authorization") String authorizationHeader) {
        // Here you could add role-based authorization checks
        return ResponseEntity.ok(requestService.getPendingRequests());
    }
    
    /**
     * Endpoint for a Checker to see all requests (pending, accepted, rejected).
     */
    @GetMapping("/all")
    public ResponseEntity<List<CommonReq>> getAllRequests(@RequestHeader("Authorization") String authorizationHeader) {
        // Here you could add role-based authorization checks
        return ResponseEntity.ok(requestService.getAllRequests());
    }

    /**
     * Endpoint for a Checker to accept or reject a request.
     */
    @PatchMapping("/{requestId}/status")
    public ResponseEntity<CommonReq> updateRequestStatus(
            @PathVariable Long requestId,
            @RequestBody UpdateRequestStatusDto updateDto,
            @RequestHeader("Authorization") String authorizationHeader) throws JsonProcessingException {

        String executorId = getUserIdFromToken(authorizationHeader);
        log.info("User {} is attempting to update status for request {}", executorId, requestId);

        return requestService.updateRequestStatus(requestId, updateDto, executorId)
                .map(ResponseEntity::ok)
                .orElse(ResponseEntity.notFound().build());
    }
}




















