     */
    @Override
    public boolean supports(MethodParameter returnType, Class<? extends HttpMessageConverter<?>> converterType) {
        // Do not wrap a response that is already in our desired format.
        if (returnType.getParameterType().equals(ApiResponse.class)) {
            return false;
        }
        
        // Do not wrap responses from Springfox/Swagger or Actuator endpoints if they are present.
        String controllerClassName = returnType.getContainingClass().getName();
        return !controllerClassName.startsWith("org.springframework.boot.actuate");
    }

    /**
     * This is the core logic. It's called before the response body is written.
     * It takes the raw object returned by the controller and wraps it in ApiResponse.success().
     */
    @Override
    public Object beforeBodyWrite(Object body, MethodParameter returnType, MediaType selectedContentType,
                                  Class<? extends HttpMessageConverter<?>> selectedConverterType,
                                  ServerHttpRequest request, ServerHttpResponse response) {

        // The GlobalExceptionHandler will format errors, so we only handle successful responses here.
        return ApiResponse.success(body);
    }
}
















