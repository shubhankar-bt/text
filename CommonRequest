package com.tcs.f1.cglservice.service;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.f1.cglservice.dto.CreateRequestDto;
import com.tcs.f1.cglservice.dto.UpdateRequestStatusDto;
import com.tcs.f1.cglservice.exception.ResourceNotFoundException;
import com.tcs.f1.cglservice.model.CommonReq;
import com.tcs.f1.cglservice.model.enums.RequestStatus;
import com.tcs.f1.cglservice.model.enums.RequestType;
import com.tcs.f1.cglservice.repository.CommonRequestRepository;
import com.tcs.f1.cglservice.service.strategy.RequestStrategyFactory;
import com.tcs.f1.cglservice.service.strategy.RequestTypeStrategy;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.List;
import java.util.Optional;

@Service
@RequiredArgsConstructor
@Slf4j
public class RequestServiceImpl implements RequestService {

    private final CommonRequestRepository commonRequestRepository;
    private final RequestStrategyFactory requestStrategyFactory;
    private final ObjectMapper objectMapper;

    @Override
    @Transactional
    public CommonReq createRequest(CreateRequestDto createRequestDto, String creatorId) throws JsonProcessingException {
        CommonReq newRequest = new CommonReq();
        newRequest.setCreatorId(creatorId);
        newRequest.setReqType(createRequestDto.getReqType());
        newRequest.setChangeType(createRequestDto.getChangeType());
        newRequest.setTargetId(createRequestDto.getTargetId());
        newRequest.setPayload(objectMapper.writeValueAsString(createRequestDto.getPayload()));
        newRequest.setReqStatus(RequestStatus.PENDING.getCode());
        return commonRequestRepository.save(newRequest);
    }

    @Override
    public List<CommonReq> getMyRequests(String userId) {
        return commonRequestRepository.findByCreatorId(userId);
    }

    @Override
    public List<CommonReq> getPendingRequests() {
        return commonRequestRepository.findByReqStatus(RequestStatus.PENDING.getCode());
    }
    
    @Override
    public List<CommonReq> getAllRequests() {
        return commonRequestRepository.findAll();
    }

    @Override
    @Transactional
    public Optional<CommonReq> updateRequestStatus(Long requestId, UpdateRequestStatusDto updateDto, String executorId) throws JsonProcessingException {
        CommonReq request = commonRequestRepository.findById(requestId)
                .orElseThrow(() -> new ResourceNotFoundException("Request not found with id: " + requestId));

        if (!request.getReqStatus().equals(RequestStatus.PENDING.getCode())) {
            log.warn("Attempted to process an already processed request with ID: {}", requestId);
            // Optionally throw an exception here, e.g., IllegalStateException
            return Optional.of(request);
        }

        RequestStatus newStatus = RequestStatus.fromCode(updateDto.getStatus());
        request.setReqStatus(newStatus.getCode());
        request.setExecutorId(executorId);
        request.setExecutorRemarks(updateDto.getRemarks());
        request.setExecutionDate(LocalDateTime.now());

        if (newStatus == RequestStatus.ACCEPTED) {
            try {
                RequestType requestType = RequestType.fromCode(request.getReqType());
                RequestTypeStrategy strategy = requestStrategyFactory.getStrategy(requestType);
                strategy.processApproval(request);
                request.setExecutionRemarks("Request approved and processed successfully.");
                 log.info("Request {} accepted and processed for type {}", requestId, requestType);
            } catch (Exception e) {
                log.error("Error processing approval for request ID {}: {}", requestId, e.getMessage(), e);
                // Important: Revert status to pending and set error remarks
                request.setReqStatus(RequestStatus.PENDING.getCode());
                request.setExecutionRemarks("Processing failed: " + e.getMessage());
                commonRequestRepository.save(request);
                // Re-throw a specific exception to indicate failure in the transaction
                throw new RuntimeException("Failed to process request approval.", e);
            }
        } else {
            request.setExecutionRemarks("Request was rejected by the checker.");
            log.info("Request {} was rejected", requestId);
        }

        return Optional.of(commonRequestRepository.save(request));
    }
}







