    public ResponseEntity<CommonReq> updateRequestStatus(
            @PathVariable Long requestId,
            @RequestBody UpdateRequestStatusDto updateDto,
            @RequestHeader("Authorization") String authorizationHeader) throws JsonProcessingException {

        String executorId = getUserIdFromToken(authorizationHeader);
        log.info("User {} is attempting to update status for request {}", executorId, requestId);

