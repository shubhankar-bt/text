    @PostMapping("/download")
    public ReportFileDto downloadReport(@RequestBody ReportDownloadRequest request) {
        // The service layer now handles the authorization check using the provided roleId.
        return reportService.getReport(request.getFileName(), request.getDate(), request.getRoleId());
    }
}












