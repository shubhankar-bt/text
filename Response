Step 4: Response Builder Utility

package com.company.project.response;

import com.company.project.enums.ErrorCode;

public class ResponseBuilder {

    public static <T> ResponseVo<T> success(T data, String message) {
        return ResponseVo.<T>builder()
                .success(true)
                .statusCode("200")
                .message(message)
                .data(data)
                .build();
    }

    public static <T> ResponseVo<T> success(T data) {
        return success(data, "Success");
    }

    public static <T> ResponseVo<T> error(ErrorCode errorCode) {
        return ResponseVo.<T>builder()
                .success(false)
                .statusCode(errorCode.getCode())
                .message(errorCode.getDefaultMessage())
                .error(new ErrorDetail(errorCode.getCode(), errorCode.getDefaultMessage()))
                .build();
    }

    public static <T> ResponseVo<T> error(ErrorCode errorCode, String customMessage) {
        return ResponseVo.<T>builder()
                .success(false)
                .statusCode(errorCode.getCode())
                .message(customMessage)
                .error(new ErrorDetail(errorCode.getCode(), customMessage))
                .build();
    }
}


