import com.tcs.f1.cglservice.dto.payload.KeyablePayload;
import com.tcs.f1.cglservice.model.enums.RequestStatus;
import org.springframework.dao.DataIntegrityViolationException;
import java.util.List;

@Service
// ...
public class RequestServiceImpl implements RequestService {
    // ... existing fields

    @Override
    @Transactional
    @PreAuthorize("hasAuthority('ROLE_MAKER')")
    public CommonReq createRequest(CreateRequestDto dto, String creatorId) throws JsonProcessingException {
        // The payload DTO is already validated by the controller, so we can trust its structure.
        KeyablePayload payload = (KeyablePayload) dto.getPayload();

        // --- PRE-FLIGHT CHECKS ---
        // 1. Extract the targetId from the payload.
        String targetId = payload.getKey();
        if (targetId == null || targetId.isBlank()) {
            throw new IllegalArgumentException("Could not determine targetId from payload.");
        }
        log.info("Determined targetId for new request as: {}", targetId);

        // 2. Check for duplicate PENDING or ACCEPTED requests for this targetId.
        List<CommonReq> existingRequests = commonRequestRepository.findByTargetIdAndReqStatusNot(targetId, RequestStatus.REJECTED);
        if (!existingRequests.isEmpty()) {
            log.warn("Attempted to create a duplicate request for targetId {} which already has a pending/active request.", targetId);
            throw new DataIntegrityViolationException("An active or pending request for '" + targetId + "' already exists.");
        }
        log.info("Uniqueness check passed for targetId: {}", targetId);

        // --- ALL CHECKS PASSED, PROCEED TO CREATE ---
        CommonReq request = new CommonReq();
        request.setCreatorId(creatorId);
        request.setReqType(dto.getRequestType());
        request.setChangeType(dto.getChangeType());
        request.setPayload(objectMapper.writeValueAsString(payload));
        request.setTargetId(targetId); // Set the targetId at creation time.
        request.setReqStatus(RequestStatus.PENDING);

        log.info("Saving new, validated request for targetId {}", targetId);
        return commonRequestRepository.save(request);
    }
    // ... rest of the service implementation is unchanged ...
}














