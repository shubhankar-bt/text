        { rowId: '13', column: 'SW_GRSAD_CY', value: data[36] },
        { rowId: '13', column: 'SW_GRSNPA_CY', value: data[37] },
        { rowId: '13', column: 'SW_GRSPERT_CY', value: data[38] },
      ];

      calculatedFieldsToSave.forEach((field) => {
        saveField(field.rowId, field.column, field.value);
      });
    },
