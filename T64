import React, { useState, useEffect, useCallback } from 'react';
import { Box, CircularProgress, Typography } from '@mui/material';
import { useLocation, useNavigate } from 'react-router-dom';
import useApi from '../../../../common/hooks/useApi';
import useCustomSnackbar from '../../../../common/hooks/useCustomSnackbar';
import FRReturnsReport from '../components/FRReturnsReport';

export default function SectorWiseNPAReport() {
  const [reportId, setReportId] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [data, setData] = useState(Array(39).fill(0.0));
  const navigate = useNavigate();
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();
  const location = useLocation();
  const user = JSON.parse(localStorage.getItem('user'));
  const report = location.state?.report;

  const api = {
    getSectorWiseNPAData: async (reportId) => {
      console.log(`Fetching data for reportId: ${reportId}...`);
      const REST_SERVICE_URI = '/SecWiseNPA/getSecWiseNPAData';
      const response = await callApi(REST_SERVICE_URI, { reportId }, 'POST');
      return response;
    },
    createNewReport: async (params) => {
      console.log('Creating new report with params:', params);
      const INSERT_URI = '/SecWiseNPA/insertOnLoad';
      const newReportId = await callApi(INSERT_URI, params, 'POST');
      return newReportId;
    },
    updateField: async (params) => {
      console.log('Updating field:', params);
      const UPDATE_URI = '/SecWiseNPA/updateField';
      const response = await callApi(UPDATE_URI, params, 'POST');
      return { success: response };
    },
  };

  const saveField = useCallback(
    async (rowId, column, value) => {
      const valueToSave = value ?? '0.00';
      try {
        const payload = {
          frReportId: reportId ?? report?.subReportFR_RID,
          rowId: String(rowId),
          column,
          value: String(valueToSave),
          qed: user.quarterEndDate,
        };
        await api.updateField(payload);
      } catch (error) {
        if (error.code !== 'ERR_CANCELED') {
          console.error('Failed to save field:', error);
        }
      }
    },
    [user, reportId, report, callApi]
  );

  const calculateAll = useCallback((currentData) => {
    const newData = [...currentData];

    const getPercentage = (npa, advances) => {
      const npaNum = parseFloat(npa) || 0;
      const advancesNum = parseFloat(advances) || 0;
      return advancesNum > 0 ? ((npaNum / advancesNum) * 100).toFixed(4) + '%' : '0.0000%';
    };

    const validateNPA = (npaIndex, advancesIndex, sectorName) => {
      let npa = parseFloat(newData[npaIndex]) || 0;
      let advances = parseFloat(newData[advancesIndex]) || 0;

      if (npa > advances) {
        // Reset both fields
        newData[advancesIndex] = '';
        newData[npaIndex] = '';

        // Show snackbar after state update
        setTimeout(() => {
          snackbar(`Gross NPA cannot exceed Gross Advances for ${sectorName}.`, 'error');
        }, 0);

        return 0.0; // Return 0 to ensure recalculations use valid data
      }
      return npa;
    };

    // --- Priority Sector (PS) ---
    const psAgriGrossAd = parseFloat(newData[3]) || 0;
    const psAgriGrossNPA = validateNPA(4, 3, 'PS Agriculture');
    const psIndGrossAd = parseFloat(newData[6]) || 0;
    const psIndGrossNPA = validateNPA(7, 6, 'PS Industry');
    const psServGrossAd = parseFloat(newData[9]) || 0;
    const psServGrossNPA = validateNPA(10, 9, 'PS Services');
    const psPersGrossAd = parseFloat(newData[12]) || 0;
    const psPersGrossNPA = validateNPA(13, 12, 'PS Personal Loans');
    const psOthGrossAd = parseFloat(newData[15]) || 0;
    const psOthGrossNPA = validateNPA(16, 15, 'PS Others');

    // --- Non-Priority Sector (NPS) ---
    const npsAgriGrossAd = parseFloat(newData[21]) || 0;
    const npsAgriGrossNPA = validateNPA(22, 21, 'NPS Agriculture');
    const npsIndGrossAd = parseFloat(newData[24]) || 0;
    const npsIndGrossNPA = validateNPA(25, 24, 'NPS Industry');
    const npsServGrossAd = parseFloat(newData[27]) || 0;
    const npsServGrossNPA = validateNPA(28, 27, 'NPS Services');
    const npsPersGrossAd = parseFloat(newData[30]) || 0;
    const npsPersGrossNPA = validateNPA(31, 30, 'NPS Personal Loans');
    const npsOthGrossAd = parseFloat(newData[33]) || 0;
    const npsOthGrossNPA = validateNPA(34, 33, 'NPS Others');

    // Recalculate Totals & Percentages with validated/reset data
    const psGrossAdTotal = psAgriGrossAd + psIndGrossAd + psServGrossAd + psPersGrossAd + psOthGrossAd;
    const psGrossNPATotal = psAgriGrossNPA + psIndGrossNPA + psServGrossNPA + psPersGrossNPA + psOthGrossNPA;
    newData[0] = psGrossAdTotal.toFixed(2);
    newData[1] = psGrossNPATotal.toFixed(2);
    newData[2] = getPercentage(psGrossNPATotal, psGrossAdTotal);
    newData[5] = getPercentage(psAgriGrossNPA, psAgriGrossAd);
    newData[8] = getPercentage(psIndGrossNPA, psIndGrossAd);
    newData[11] = getPercentage(psServGrossNPA, psServGrossAd);
    newData[14] = getPercentage(psPersGrossNPA, psPersGrossAd);
    newData[17] = getPercentage(psOthGrossNPA, psOthGrossAd);

    const npsGrossAdTotal = npsAgriGrossAd + npsIndGrossAd + npsServGrossAd + npsPersGrossAd + npsOthGrossAd;
    const npsGrossNPATotal = npsAgriGrossNPA + npsIndGrossNPA + npsServGrossNPA + npsPersGrossNPA + npsOthGrossNPA;
    newData[18] = npsGrossAdTotal.toFixed(2);
    newData[19] = npsGrossNPATotal.toFixed(2);
    newData[20] = getPercentage(npsGrossNPATotal, npsGrossAdTotal);
    newData[23] = getPercentage(npsAgriGrossNPA, npsAgriGrossAd);
    newData[26] = getPercentage(npsIndGrossNPA, npsIndGrossAd);
    newData[29] = getPercentage(npsServGrossNPA, npsServGrossAd);
    newData[32] = getPercentage(npsPersGrossNPA, npsPersGrossAd);
    newData[35] = getPercentage(npsOthGrossNPA, npsOthGrossAd);

    const grandTotalGrossAd = psGrossAdTotal + npsGrossAdTotal;
    const grandTotalGrossNPA = psGrossNPATotal + npsGrossNPATotal;
    newData[36] = grandTotalGrossAd.toFixed(2);
    newData[37] = grandTotalGrossNPA.toFixed(2);
    newData[38] = getPercentage(grandTotalGrossNPA, grandTotalGrossAd);

    return newData;
  }, []);

  const handleCellChange = useCallback(
    (item, value) => {
      const newRawData = [...data];
      newRawData[item.dataIndex] = value;
      const calculatedData = calculateAll(newRawData);
      setData(calculatedData);
    },
    [data, calculateAll]
  );

  const handleCellBlur = useCallback(
    (item, value) => {
      if (!item) return;

      // Save the field that was directly edited
      if (item.saveConfig) {
        saveField(item.saveConfig.rowId, item.saveConfig.column, value);
      }

      const calculatedFieldsToSave = [
        { rowId: '1', column: 'SW_GRSAD_CY', value: data[0] },
        { rowId: '1', column: 'SW_GRSNPA_CY', value: data[1] },
        { rowId: '1', column: 'SW_GRSPERT_CY', value: data[2] },
        { rowId: '2', column: 'SW_GRSPERT_CY', value: data[5] },
        { rowId: '3', column: 'SW_GRSPERT_CY', value: data[8] },
        { rowId: '4', column: 'SW_GRSPERT_CY', value: data[11] },
        { rowId: '5', column: 'SW_GRSPERT_CY', value: data[14] },
