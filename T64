    // This function now validates a pair and modifies the `newData` array directly.
    const validateNPA = (npaIndex, advancesIndex, sectorName) => {
      const npa = parseFloat(newData[npaIndex]) || 0;
      const advances = parseFloat(newData[advancesIndex]) || 0;

      if (npa > advances) {
        // By clearing the values in the array first, all subsequent logic will use the correct cleared values.
        newData[advancesIndex] = '';
        newData[npaIndex] = '';

        setTimeout(() => {
          snackbar(`Gross NPA cannot exceed Gross Advances for ${sectorName}.`, 'error');
