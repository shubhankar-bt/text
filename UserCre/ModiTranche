} from '@mui/icons-material';
import useCustomSnackbar from '../../../../common/hooks/useCustomSnackbar';
import useApi from '../../../../common/hooks/useApi';
import { CustomButton } from '../../../../common/components/ui/Buttons';
import ConfirmationDialog from '../../../../common/components/ui/dialogs/ConfirmationDialog';

const emptyObj = { id: '', name: '', circle: '', role: '' };

const UserDialog = (props) => {
  const loginUser = JSON.parse(localStorage.getItem('user'));
  const snackbar = useCustomSnackbar();
  const [user, setUser] = useState(emptyObj);
  const [tempUser, setTempUser] = useState(emptyObj);
  const [title, setTitle] = useState('');
  const { callApi } = useApi();
  const theme = useTheme();
  const [confimDeleteDialogUser, setConfimDeleteDialogUser] = useState(null);

  useEffect(() => {
    titleAssignment();
    if (
      props.requestType === 'modify' ||
      (props.requestType === 'request action' && props.userDetails.REQ_TYPE !== 'M')
    ) {
      let newObj = {};
      newObj.id = props.userDetails.USER_ID;
      newObj.name = props.userDetails.CURR_USER_NAME;
      newObj.circle = props.userDetails.CURR_CIRCLE === '100' ? '' : props.userDetails.CURR_CIRCLE;
      newObj.role = props.userDetails.CURR_ROLE;
      setUser({ ...newObj });
    } else if (props.requestType === 'create') {
      setUser(emptyObj);
    } else if (
      props.requestType === 'request modify' ||
      (props.requestType === 'request action' && props.userDetails.REQ_TYPE === 'M')
    ) {
      let newObj = {};

      newObj.id = props.userDetails.USER_ID;
      newObj.name = props.userDetails.NEW_USER_NAME;
      newObj.circle = props.userDetails.NEW_USER_CIRCLE === '100' ? '' : props.userDetails.NEW_USER_CIRCLE;
      newObj.role = props.userDetails.NEW_USER_ROLE;
      setUser({ ...newObj });
      setTempUser({ ...newObj });
    }
  }, [props.open]);

  /**
   * This function is to handle the title assignment.
   *
   * @author: V1014064
   */
  const titleAssignment = () => {
    if (props.requestType === 'request modify') {
      setTitle('Modify Request');
    } else if (props.requestType === 'modify') {
      setTitle('Modify User');
    } else if (props.requestType === 'create') {
      setTitle('Create User');
    } else if (props.requestType === 'request action') {
      props.userDetails.REQ_TYPE === 'E'
        ? setTitle('Enable Request')
        : props.userDetails.REQ_TYPE === 'DL'
        ? setTitle('Delete Request')
        : props.userDetails.REQ_TYPE === 'M'
        ? setTitle('Modify Request')
        : props.userDetails.REQ_TYPE === 'U'
        ? setTitle('Unstale Request')
        : props.userDetails.REQ_TYPE === 'C'
        ? setTitle('Create Request')
        : props.userDetails.REQ_TYPE === 'D'
        ? setTitle('Disable Request')
        : setTitle('');
    }
  };

  /**
   * This function is to handle the filters change.
   *
   * @author: V1014064
   *
   * @param type: defines the type of text field.
   * @param value: containes the user entered value.
   */
  const handleChange = (type, value) => {
    let regex;
    const newTerm = { ...user };
    if (type === 'id') {
      regex = /^\d*$/;
      if (!regex.test(value)) return;
      if (!Number.isNaN(parseInt(value)) && parseInt(value) * 1 === 0) {
        snackbar('User Id cannot be starteed with 0.', 'error');
        return;
      }
      newTerm[type] = (Number.isNaN(parseInt(value) * 1) ? '' : parseInt(value) * 1).toString();
      setUser(newTerm);
      return;
    } else if (type === 'name') {
      regex = /^[a-zA-Z\s]*$/;
      if (!regex.test(value)) return;
    }
    if (
      (type === 'role' && value !== '51' && value !== '52' && value !== '53') ||
      (user.role !== '51' && user.role !== '52' && user.role !== '53' && user.role !== '' && type !== 'role')
    ) {
      newTerm.circle = '';
    }
    newTerm[type] = value;
    setUser(newTerm);
  };

  /**
   * This function is to close the modal and reset all the state variables.
   *
   * @author: V1014064
   *
   */
  const dialogClose = () => {
    setUser(emptyObj);
    setTempUser(emptyObj);
    setTitle('');
    props.close(false);
  };

  /**
   * This function is an api call to store all the details and the type of request in the database.
   *
   * @param flag: Contains a string to denote the type of request to be made.
   *
   * @author: V1014064
   */
  const generateRequest = async (flag) => {
    let payload;
    let startMessage =
      flag === 'C'
        ? 'Create '
        : flag === 'M'
        ? 'Modify '
        : flag === 'DL'
        ? 'Delete '
        : flag === 'D'
        ? 'Disable '
        : flag === 'E'
        ? 'Enable '
        : 'Unstale';
    let message = startMessage + ' request for user id ' + user.id;
    let circle = user.role === '51' || user.role === '52' || user.role === '53' ? user.circle : '100';

    try {
      if (
        user.id === '' ||
        user.name.trim() === '' ||
        ((user.circle === '' || user.circle === '100') &&
          (user.role === '51' || user.role === '52' || user.role === '53')) ||
        user.role === ''
      ) {
        snackbar('Kindly fill all the data.', 'error');
        props.loading(false);
        return;
      }
      if (user.id.length !== 7) {
        snackbar('Kindly make sure the entered User id is 7 digits.', 'error');
        props.loading(false);
        return;
      }

      if (props.requestType === 'create') {
        for (const samp of props.allUsers) {
          if (user.id === samp.USER_ID) {
            snackbar('User with this id already exists.', 'error');
            props.loading(false);
            return;
          }
        }
      }

      if (props.requestType === 'modify' && flag === 'M') {
        if (
          props.userDetails.CURR_USER_NAME === user.name &&
          props.userDetails.CURR_CIRCLE === circle &&
          props.userDetails.CURR_ROLE === user.role
        ) {
          snackbar('Kindly make a change before Updating the user.', 'error');
          props.loading(false);
          return;
        }
      }

      if (flag === 'C') {
        payload = {
          data: {
            USER_ID: user.id,
            NEW_USER_NAME: user.name,
            NEW_USER_ROLE: user.role,
            NEW_USER_CIRCLE: circle,
          },
          flag: flag,
          userId: loginUser.userId,
        };
      } else if (flag === 'M') {
        let mapToSend = { ...props.userDetails };
        mapToSend.NEW_USER_NAME = user.name;
        mapToSend.NEW_USER_ROLE = user.role;
        mapToSend.NEW_USER_CIRCLE = circle;
        payload = {
          data: mapToSend,
          flag: flag,
          userId: loginUser.userId,
        };
      } else {
        payload = {
          data: { USER_ID: user.id },
          flag: flag,
          userId: loginUser.userId,
        };
      }

      const responseData = await callApi('/Users/generateRequest', payload, 'POST');
      if (responseData === true) {
        dialogClose();
        snackbar(message + ' generated successfully.', flag === 'DL' ? 'warning' : 'success');
        await props.reFetchUsers(props.setter, callApi, props.setDispMessage);
      } else {
        flag === 'C' ? snackbar('Error Disabling User.', 'error') : snackbar(message + ' generation failed.', 'error');
      }
      props.loading(false);
    } catch (error) {
      console.error('An error occured when generating request, Kindly try again after some time.', error);
      snackbar('An error occured, Kindly try again after some time.', 'error');
      props.loading(false);
    }
  };

  /**
   * This is an asynchronous function responsible for updating the request of the user.
   *
   * @author: V1014064
   */
  const modifyRequest = async () => {
    if (
      user.id === '' ||
      user.name.trim() === '' ||
      ((user.circle === '' || user.circle === '100') &&
        (user.role === '51' || user.role === '52' || user.role === '53')) ||
      user.role === ''
    ) {
      snackbar('Kindly fill all the data.', 'error');
      props.loading(false);
      return;
    }

    if (tempUser.name === user.name && tempUser.circle === user.circle && tempUser.role === user.role) {
      snackbar('Kindly make a change before Updating the request.', 'error');
      props.loading(false);
      return;
    }

    let circle = user.role === '51' || user.role === '52' || user.role === '53' ? user.circle : '100';

    let mapToSend = { ...props.userDetails };

    mapToSend.NEW_USER_NAME = user.name;
    mapToSend.NEW_USER_ROLE = user.role;
    mapToSend.NEW_USER_CIRCLE = circle;

    let payload = {
      data: mapToSend,
      userId: loginUser.userId,
    };
    try {
      const responseData = await callApi('/Users/updateRequest', payload, 'POST');
      if (responseData === true) {
        dialogClose();
        snackbar('Request modified succcessfully for user id ' + user.id + '.', 'success');
        await props.reFetchUsers(props.setter, callApi, props.setDispMessage);
      } else {
        snackbar('Request modification falied for user id ' + user.id + '.', 'error');
      }
