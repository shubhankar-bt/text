            onChange={(e) => {
              handleChange('circle', e.target.value);
            }}
            MenuProps={{ PaperProps: { sx: { maxHeight: 500 } } }}
          >
            <MenuItem value="">---Circle---</MenuItem>
            {props.circleList.map((circle) => (
              <MenuItem value={circle.CIRCLE_NAME}>{circle.CIRCLE_NAME}</MenuItem>
            ))}
          </Select>
        </Stack>

        <Stack>
          <Typography color="text.secondary" gutterBottom>
            User Status
          </Typography>
          <Select
            variant="outlined"
            value={props.searchTerm.status}
            sx={{ minWidth: 220 }}
