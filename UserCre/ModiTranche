import {
  Avatar,
  Box,
  Button,
  Card,
  CardActions,
  CardContent,
  Chip,
  Divider,
  Grid,
  Stack,
  Tooltip,
  Typography,
  useTheme,
} from '@mui/material';
import { Delete, Edit, RemoveRedEye } from '@mui/icons-material';

const bgColors = {
  enable: '#A8E6CF',
  delete: '#FFABAB',
  modify: '#ADD8E6',
  unstale: '#FFF9C4',
  create: '#E1BEE7',
  disable: '#D3D3D3',
};

function getDynamicColor(requestType) {
  return bgColors[
    requestType === 'E'
      ? 'enable'
      : requestType === 'DL'
      ? 'delete'
      : requestType === 'M'
      ? 'modify'
      : requestType === 'U'
      ? 'unstale'
      : requestType === 'C'
      ? 'create'
      : requestType === 'D'
      ? 'disable'
      : ''
  ];
}

function stringAvatar(user, isStaticColor) {
  const name =
    user.CURR_USER_NAME.charAt(0).toUpperCase() +
    ' ' +
    (user.CURR_USER_NAME.includes(' ')
      ? user.CURR_USER_NAME.split(' ')[1].charAt(0).toUpperCase() !== undefined
        ? user.CURR_USER_NAME.split(' ')[1].charAt(0).toUpperCase()
        : user.CURR_USER_NAME.split(' ')[1].charAt(1).toUpperCase()
      : user.CURR_USER_NAME?.charAt(1).toUpperCase());
  let a = name.split(' ')[0][0];
  let b = name.split(' ')[1][0];
  return {
    sx: {
      color: '#000',
      bgcolor: isStaticColor ? 'primary.light' : getDynamicColor(user.REQ_TYPE),
    },
    children: `${a + b}`,
  };
}

// cardType = 'creationModification' | 'myRequest' | 'pendingRequest'

export default function UserCard({
  user,
  loggedInUser,
  onModifyClick,
  onDeleteClick,
  onViewClick,
  cardType = 'creationModification',
  isStaticColor = true,
}) {
  const theme = useTheme();
  const shoudShowUserCard = () => {
    switch (cardType) {
      case 'creationModification':
        return !(user.REQ_ID !== -1 && user.REQ_TYPE === 'C');
      case 'myRequest':
        return user.REQ_ID !== -1 && user.REQ_CREATED_BY === loggedInUser.userId;
      case 'pendingRequest':
        return user.REQ_ID !== -1 && user.REQ_CREATED_BY !== loggedInUser.userId;
      default:
        return false;
    }
  };
  return (
    shoudShowUserCard() && (
      <Grid item key={user.USER_ID} size={{ sm: 6, md: 4, xl: 3 }}>
        <Card sx={{ width: '100%' }}>
          <CardContent>
            <Stack direction={'row'} alignItems={'center'} justifyContent={'space-between'}>
              <Stack direction={'row'} spacing={2} alignItems={'center'}>
                <Avatar
                  variant="rounded"
                  sx={{
                    alignItems: 'center',
                    width: 100,
                    height: 100,
                    mt: 2,
                    textAlign: 'center',
                  }}
                  {...stringAvatar(user, isStaticColor)}
                />
                <Stack>
                  <Typography fontSize={12} color="text.secondary">
                    User ID
                  </Typography>
                  <Typography fontSize={18} fontWeight={'bold'}>
                    {user.USER_ID}
                  </Typography>
                </Stack>
              </Stack>
              {cardType !== 'creationModification' && (
                <Card
                  variant="outlined"
                  sx={{ px: 1, py: 0.4, borderRadius: 3 }}
                  style={{ backgroundColor: getDynamicColor(user.REQ_TYPE) }}
                >
                  <Typography fontSize={12} color="black">
                    {user.REQ_TYPE === 'E'
                      ? 'Enable Request'
                      : user.REQ_TYPE === 'DL'
                      ? 'Delete Request'
                      : user.REQ_TYPE === 'M'
                      ? 'Modify Request'
                      : user.REQ_TYPE === 'U'
                      ? 'Unstale Request'
                      : user.REQ_TYPE === 'C'
                      ? 'Create Request'
                      : user.REQ_TYPE === 'D'
                      ? 'Disable Request'
                      : ''}
                  </Typography>
                </Card>
              )}
            </Stack>
            <Divider sx={{ my: 1 }} />
            <Grid>
              <Box sx={{ textOverflow: 'ellipsis', overflow: 'hidden', whiteSpace: 'nowrap' }}>
                <Typography sx={{ fontWeight: 'bold', color: 'text.secondary', display: 'inline-block' }}>
                  Name:&nbsp;
                </Typography>
                <Tooltip title={user.CURR_USER_NAME}>
                  <Typography sx={{ display: 'inline-block' }}>{user.CURR_USER_NAME}</Typography>
                </Tooltip>
              </Box>
              <Box sx={{ textOverflow: 'ellipsis', overflow: 'hidden', whiteSpace: 'nowrap' }}>
                <Typography sx={{ fontWeight: 'bold', color: 'text.secondary', display: 'inline-block' }}>
                  Circle:&nbsp;
                </Typography>
                <Tooltip title={user.CURR_CIRCLE_NAME}>
                  <Typography sx={{ display: 'inline-block' }}>{user.CURR_CIRCLE_NAME}</Typography>
                </Tooltip>
              </Box>
              <Box>
                <Typography sx={{ fontWeight: 'bold', color: 'text.secondary', display: 'inline-block' }}>
                  Role:&nbsp;
                </Typography>
                <Typography sx={{ display: 'inline-block' }}>{user.CURR_ROLE_NAME}</Typography>
              </Box>
            </Grid>
          </CardContent>
          <Divider sx={{ my: 1 }} />
          <CardActions sx={{ display: 'flex', justifyContent: 'end', alignItems: 'center', mt: 2 }}>
            {cardType === 'creationModification' &&
              (user.REQ_ID === -1 ? (
                <Button
                  onClick={onModifyClick}
                  startIcon={<Edit />}
                  variant="outlined"
                  disabled={user.REQ_ID !== -1}
                  sx={{ width: '100%' }}
                >
                  Modify User
                </Button>
              ) : (
                <Tooltip title={'There is already one Request Pending for user, Please Take action on that first.'}>
                  <Button variant="outlined" sx={{ width: '100%' }}>
                    Request pending...
                  </Button>
                </Tooltip>
              ))}
            {cardType === 'myRequest' && (
              <>
                {user.REQ_TYPE === 'M' && (
                  <Button onClick={onModifyClick} startIcon={<Edit />} variant="outlined" sx={{ width: '100%' }}>
