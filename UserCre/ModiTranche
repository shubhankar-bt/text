          <Typography color="text.secondary" gutterBottom>
            User ID
          </Typography>
          <FormInput
            value={props.searchTerm.id}
            onChange={(e) => {
              handleChange('id', e.target.value);
            }}
            slotProps={{
              htmlInput: {
                maxLength: 7,
              },
            }}
            debounceDuration={1000}
            inputType={'alphaNumeric'}
          />
        </Stack>

        <Stack>
          <Typography color="text.secondary" gutterBottom>
            User Name
          </Typography>
          <FormInput
            value={props.searchTerm.name}
            onChange={(e) => {
              handleChange('name', e.target.value);
            }}
            slotProps={{
              htmlInput: {
                maxLength: 7,
              },
            }}
            debounceDuration={1000}
            inputType={'alphaNumeric'}
          />
        </Stack>

        <Stack>
          <Typography color="text.secondary" gutterBottom>
            User Role
          </Typography>
          <Select
            variant="outlined"
            value={props.searchTerm.role}
            sx={{ minWidth: 220 }}
            onChange={(e) => {
              handleChange('role', e.target.value);
            }}
