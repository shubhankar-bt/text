import { Box, Divider, Fab, Grid, LinearProgress, Stack, Typography } from '@mui/material';
import { useEffect, useState } from 'react';
import { PersonAdd } from '@mui/icons-material';
import UserDialog from './components/UserDialog';
import useApi from '../../../common/hooks/useApi';
import { getCircleList, getRoleList, getUsers } from './Services/commonUserManagentCalls';
import LoadingOverlay from '../../../common/components/ui/loadingOverlay';
import FilterComponent from './components/FilterComponent';
import UserCard from './components/UserCard';
import { filter } from 'lodash';

const UserCreationModification = () => {
  const [searchTerm, setSearchTerm] = useState({ id: '', name: '', role: '', circle: '', status: '' });
  const [allUserList, setAllUserList] = useState([]);
  const [circleList, setCircleList] = useState([]);
  const [roleList, setRoleList] = useState([]);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [selectedUser, setSelectedUser] = useState({});
  const [requestType, setRequestType] = useState('');
  const [loadOpen, setLoadOpen] = useState(false);
  const [circleDisable, setCircleDisable] = useState(false);
  const [dispMessage, setDispMessage] = useState('Loading…');

  const loginUser = JSON.parse(localStorage.getItem('user'));
  const { callApi } = useApi();

  useEffect(() => {
    totalCalls().then(() => {
      console.log('users fetched.');
    });
  }, []);

  /**
   * This code is responsible for filtering of all the existing users data based on user entered parameters.
   *
   *
   */
  const filteredItems = allUserList.filter(
    (user) =>
      user.USER_ID.toString().includes(searchTerm.id.toString().toLowerCase()) &&
      user.CURR_USER_NAME.toString().toLowerCase().includes(searchTerm.name.toString().toLowerCase()) &&
      user.CURR_ROLE_NAME.toString().toLowerCase().includes(searchTerm.role.toString().toLowerCase()) &&
      user.CURR_CIRCLE_NAME.toString().toLowerCase().includes(searchTerm.circle.toString().toLowerCase()) &&
      user.CURRENT_STATUS.toString().toLowerCase().includes(searchTerm.status.toString().toLowerCase()) &&
      user.REQ_CREATED_BY !== loginUser.userId &&
      user.REQ_TYPE !== 'C'
  );

  /**
   * This is an asynchronous function responsible for calling all the functions to fetch the necessary data on load.
   *
   *
   */
  const totalCalls = async () => {
    getCircleList(setCircleList, callApi);
    getRoleList(setRoleList, callApi);
    getUsers(setAllUserList, callApi, setDispMessage);
  };

  return (
    <>
      <FilterComponent
        searchTerm={searchTerm}
        setSearchTerm={setSearchTerm}
        circleDisable={circleDisable}
        setCircleDisable={setCircleDisable}
        roleList={roleList}
        circleList={circleList}
      />
      <Divider sx={{ mt: 3 }} />
      <Box sx={{ mt: 3 }}>
        <Grid container spacing={3} direction="row">
          {allUserList.length > 0 ? (
            <>
              {filteredItems.length > 0 ? (
                <>
                  {filteredItems.map((user) => (
                    <UserCard
                      user={user}
                      loggedInUser={loginUser}
                      cardType="creationModification"
                      onModifyClick={() => {
                        setSelectedUser(user);
                        setRequestType('modify');
                        setDialogOpen(true);
                      }}
                    />
                  ))}
                </>
              ) : (
                <Grid item alignContent="center">
                  <Typography>
                    The user with selected parameters does not exist or it's request for creation is pending with
                    another UCO user. (Clear Filter to view all users)
                  </Typography>
                </Grid>
              )}
              <Box height={80} width={360} />
            </>
          ) : (
            <Stack item width={'100%'} sx={{ alignItems: 'center' }}>
              <LinearProgress sx={{ width: '100%', mb: 1 }} />
              <Typography>{dispMessage}</Typography>
            </Stack>
          )}
        </Grid>
        <Fab
          color="primary"
          variant="extended"
          onClick={() => {
            setSelectedUser({ USER_ID: '', NEW_USER_NAME: '', NEW_USER_CIRCLE: '', NEW_USER_ROLE: '' });
            setRequestType('create');
            setDialogOpen(true);
          }}
          sx={{
            position: 'fixed',
            borderRadius: 1,
            fontSize: '15px',
            bottom: (theme) => theme.spacing(6),
            right: (theme) => theme.spacing(8),
          }}
        >
          <PersonAdd sx={{ mr: 1 }} />
          Create User
        </Fab>

        <UserDialog
          open={dialogOpen}
          close={setDialogOpen}
          requestType={requestType}
          userDetails={selectedUser}
          circleList={circleList}
          roleList={roleList}
          allUsers={allUserList}
          reFetchUsers={getUsers}
          loading={setLoadOpen}
          setter={setAllUserList}
          setDispMessage={setDispMessage}
        />

        <LoadingOverlay loading={loadOpen} />
      </Box>
    </>
  );
};

export default UserCreationModification;





