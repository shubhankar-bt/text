import { FilterListAlt } from '@mui/icons-material';
import { Button, Card, MenuItem, Select, Stack, Typography } from '@mui/material';
import propTypes from 'prop-types';
import FormInput from '../../../../common/components/ui/FormInput';

const FilterComponent = (props) => {
  /**
   * This function is to handle the filters change.
   *
   * @param type : defines the type of text field.
   * @param value : containes the user entered value.
   */
  const handleChange = (type, value) => {
    if (type === 'button') {
      props.setSearchTerm({ id: '', name: '', role: '', circle: '', status: '' });
      props.setCircleDisable(false);
    } else {
      let regex;
      if (type === 'id') {
        regex = /^\d*$/;
        if (!regex.test(value)) return;
      }
      if (type === 'name') {
        regex = /^[a-zA-Z\s]*$/;
        if (!regex.test(value)) return;
      }

      const newTerm = { ...props.searchTerm };
      if (
        (type === 'role' && value !== 'CIRCLE MAKER' && value !== 'CIRCLE CHECKER' && value !== 'CIRCLE APPROVER') ||
        (props.searchTerm.role !== 'CIRCLE MAKER' &&
          props.searchTerm.role !== 'CIRCLE CHECKER' &&
          props.searchTerm.role !== 'CIRCLE APPROVER' &&
          props.searchTerm.role !== '' &&
          type !== 'role')
      ) {
        props.setCircleDisable(true);
        newTerm.circle = '';
      } else {
        props.setCircleDisable(false);
      }

      newTerm[type] = value;
      props.setSearchTerm(newTerm);
    }
  };

  return (
    <Stack component={Card} p={2} direction={'row'} justifyContent={'space-between'} alignItems={'end'}>
      <Stack direction={'row'} spacing={2} justifyContent={'start'}>
