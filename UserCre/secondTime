import { useState, useEffect } from 'react';
import {
  Dialog, DialogTitle, DialogContent, DialogActions, Button, Grid, TextField,
  Typography, FormControl, Select, MenuItem, Divider, IconButton
} from '@mui/material';
import { Close as CloseIcon } from '@mui/icons-material';

const UserModifyDialog = ({ open, onClose, userDetails, roleList, circleList, onUpdate }) => {
  const [user, setUser] = useState({});
  const [isCircleDisabled, setIsCircleDisabled] = useState(false);

  useEffect(() => {
    // When the dialog opens, initialize its state with the user's current details
    if (userDetails) {
      const currentUserRole = roleList.find(r => r.capacity === userDetails.role) || null;
      const currentUserCircle = circleList.find(c => c.circleCode === userDetails.circleCode) || null;

      setUser({
        ...userDetails,
        role: currentUserRole,
        circleCode: currentUserCircle,
      });

      // Set the initial state of the circle dropdown
      if (currentUserRole && parseInt(currentUserRole.capacity, 10) > 60) {
        setIsCircleDisabled(true);
      } else {
        setIsCircleDisabled(false);
      }
    }
  }, [open, userDetails, roleList, circleList]);

  // Generic handler to update the dialog's state
  const handleFieldChange = (field, value) => {
    const updatedUser = { ...user, [field]: value };
    setUser(updatedUser);

    // If the role changes, check if the circle field should be disabled
    if (field === 'role') {
      if (value && parseInt(value.capacity, 10) > 60) {
        setIsCircleDisabled(true);
        // Automatically set circle for FRT/GITC users
        updatedUser.circleCode = { circleCode: '100', circleName: 'FRT/GITC Users' };
      } else {
        setIsCircleDisabled(false);
      }
      setUser(updatedUser);
    }
  };

  const handleSaveChanges = () => {
    // Before passing the data up, format it to match the payload structure
    const payload = {
      ...user,
      role: user.role.capacity,
      circleCode: user.circleCode.circleCode,
    };
    onUpdate(payload);
    onClose();
  };

  return (
    <Dialog open={open} onClose={onClose} fullWidth maxWidth="md">
      <DialogTitle sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
        Update User Details
        <IconButton onClick={onClose}><CloseIcon /></IconButton>
      </DialogTitle>
      <Divider />
      <DialogContent>
        <Grid container spacing={3} sx={{ mt: 1 }}>
          <Grid item xs={12} sm={6}>
            <FormControl fullWidth>
              <Typography>User ID</Typography>
              <TextField variant="outlined" value={user.userId || ''} disabled />
            </FormControl>
          </Grid>
          <Grid item xs={12} sm={6}>
            <FormControl fullWidth>
              <Typography>User Name</Typography>
              <TextField variant="outlined" value={user.userName || ''} onChange={(e) => handleFieldChange('userName', e.target.value)} />
            </FormControl>
          </Grid>
          <Grid item xs={12} sm={6}>
            <FormControl fullWidth required>
              <Typography>User Role</Typography>
              <Select
                variant="outlined"
                value={user.role ? user.role.capacity : ''}
                onChange={(e) => {
                  const selectedRole = roleList.find(r => r.capacity === e.target.value);
                  handleFieldChange('role', selectedRole);
                }}
              >
                {roleList.map((r) => (
                  <MenuItem key={r.capacity} value={r.capacity}>{r.role}</MenuItem>
                ))}
              </Select>
            </FormControl>
          </Grid>
          <Grid item xs={12} sm={6}>
            <FormControl fullWidth required>
              <Typography>User Circle</Typography>
              <Select
                variant="outlined"
                value={user.circleCode ? user.circleCode.circleCode : ''}
                onChange={(e) => {
                  const selectedCircle = circleList.find(c => c.circleCode === e.target.value);
                  handleFieldChange('circleCode', selectedCircle);
                }}
                disabled={isCircleDisabled}
              >
                {circleList.map((c) => (
                  <MenuItem key={c.circleCode} value={c.circleCode}>{`${c.circleCode} - ${c.circleName}`}</MenuItem>
                ))}
              </Select>
            </FormControl>
          </Grid>
          <Grid item xs={12} sm={6}>
            <FormControl fullWidth>
              <Typography>User Status</Typography>
              <TextField variant="outlined" value={user.userStatus || ''} disabled />
            </FormControl>
          </Grid>
        </Grid>
      </DialogContent>
      <Divider />
      <DialogActions sx={{ p: 2 }}>
        <Button onClick={onClose} variant="outlined">Cancel</Button>
        <Button onClick={handleSaveChanges} variant="contained" color="primary">Update User</Button>
      </DialogActions>
    </Dialog>
  );
};

export default UserModifyDialog;



























import { useState, useEffect } from 'react';
import {
  Box, Tab, Tabs, Typography, TextField, Button, Grid, Card, CardContent,
  CardActions, Divider, CircularProgress, Avatar, CardHeader, Dialog,
  DialogActions, DialogContent, DialogContentText, DialogTitle, FormControl,
  Select, MenuItem,
} from '@mui/material';
import {
  PersonAdd as PersonAddIcon, ManageAccounts as ManageAccountsIcon,
  GroupAdd as GroupAddIcon, RestartAlt as ResetIcon,
} from '@mui/icons-material';

// --- Import your services, hooks, and the new dialog ---
import {
  getRoleList, getCircleList, createUser, checkUserDetails, updateUser, deleteUser
} from './Services/userManagementService'; // Adjust path if needed
import useApi from '../hooks/useApi'; // Adjust path if needed
import useCustomSnackbar from '../hooks/useCustomSnackbar'; // Adjust path if needed
import UserModifyDialog from './Components/UserModifyDialog'; // Adjust path if needed

const getLoginUser = () => {
  const user = localStorage.getItem('user');
  return user ? JSON.parse(user) : {};
};

function TabPanel(props) {
  const { children, value, index, ...other } = props;
  return (
    <div role="tabpanel" hidden={value !== index} {...other}>
      {value === index && <Box sx={{ p: { xs: 1, sm: 3 } }}>{children}</Box>}
    </div>
