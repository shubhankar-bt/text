                    <CardContent sx={{ textAlign: 'center' }}>
                        <GroupAddIcon sx={{ fontSize: 80, color: 'primary.main' }} />
                        <Typography variant="h5" component="div" gutterBottom sx={{ mt: 2 }}>
                            New User Registration
                        </Typography>
                        <Typography color="text.secondary">
                            Fill in the details on the right to create a new user account. Ensure all information is accurate before submission.
                        </Typography>
                    </CardContent>
                </Card>
            </Grid>

            {/* Form Panel */}
            <Grid item xs={12} md={7}>
                <Card variant="outlined">
                     <CardHeader title="User Creation Form" />
                     <Divider/>
                    <CardContent>
                        <Grid container spacing={3}>
                            <Grid item xs={12} sm={6}>
                                <TextField label="User ID" value={newUser.userId} onChange={(e) => setNewUser({...newUser, userId: e.target.value})} fullWidth required inputProps={{ maxLength: 7 }} />
                            </Grid>
                            <Grid item xs={12} sm={6}>
                                <TextField label="User Name" value={newUser.userName} onChange={(e) => setNewUser({...newUser, userName: e.target.value})} fullWidth required inputProps={{ maxLength: 60 }} />
                            </Grid>
                            <Grid item xs={12} sm={6}>
                                <Autocomplete
                                    options={roleList}
                                    getOptionLabel={(option) => option.role || ""}
                                    value={newUser.role || null}
                                    isOptionEqualToValue={(option, value) => option.capacity === value.capacity}
                                    onChange={(event, newValue) => handleNewUserAutocompleteChange('role', newValue)}
                                    renderInput={(params) => <TextField {...params} label="User Role" required />}
                                />
                            </Grid>
                            <Grid item xs={12} sm={6}>
                                <Autocomplete
                                    options={circleList}
                                    getOptionLabel={(option) => `${option.circleCode} - ${option.circleName}` || ""}
                                    value={newUser.circleCode || null}
                                    isOptionEqualToValue={(option, value) => option.circleCode === value.circleCode}
                                    onChange={(event, newValue) => handleNewUserAutocompleteChange('circleCode', newValue)}
                                    disabled={isCircleDisabled}
                                    renderInput={(params) => <TextField {...params} label="User Circle" required />}
                                />
                            </Grid>
                        </Grid>
                    </CardContent>
                    <Divider/>
                    <CardActions sx={{ justifyContent: 'flex-end', p: 2 }}>
                        <Button variant="contained" onClick={handleCreateUser} disabled={isLoading} endIcon={isLoading ? <CircularProgress size={20} color="inherit" /> : <PersonAddIcon />}>
                            Create User
                        </Button>
                    </CardActions>
                </Card>
            </Grid>
        </Grid>
      </TabPanel>

      {/* --- MODIFY USER PANEL (REFINED) --- */}
      <TabPanel value={tabIndex} index={1}>
        {/* ... (Search bar remains the same) ... */}

        {fetchedUserDetails && (
             <Card sx={{ mt: 4 }} variant="outlined">
                <CardHeader
                    avatar={<Avatar sx={{ bgcolor: 'primary.main' }}><ManageAccountsIcon /></Avatar>}
