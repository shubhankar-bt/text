package com.tcs.f1.cglservice.service.strategy;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.f1.cglservice.dto.CglPayloadDto;
import com.tcs.f1.cglservice.model.CGLMaster;
import com.tcs.f1.cglservice.model.CommonReq;
import com.tcs.f1.cglservice.model.enums.RequestType;
import com.tcs.f1.cglservice.repository.CGLMasterRepository;
import jakarta.validation.ConstraintViolation;
import jakarta.validation.ConstraintViolationException;
import jakarta.validation.Validator;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;

import java.util.Set;

@Component
@RequiredArgsConstructor
@Slf4j
public class CglCodeStrategy implements RequestTypeStrategy {

    private final CGLMasterRepository cglMasterRepository;
    private final ObjectMapper objectMapper;
    private final Validator validator; // Inject the standard Jakarta Validator

    @Override
    public RequestType getRequestType() {
        return RequestType.CGL_CODE;
    }

    @Override
    public void approve(CommonReq request) throws JsonProcessingException {
        String payloadJson = request.getPayload();
        log.info("Approving CGL Code request ID: {}. Payload: {}", request.getId(), payloadJson);

        // Step 1: Deserialize payload into the validation DTO
        CglPayloadDto payloadDto = objectMapper.readValue(payloadJson, CglPayloadDto.class);

        // Step 2: PROACTIVELY VALIDATE the payload DTO
        Set<ConstraintViolation<CglPayloadDto>> violations = validator.validate(payloadDto);
        if (!violations.isEmpty()) {
            // If validation fails, throw a specific exception with a clear message.
            // The GlobalExceptionHandler will catch this and return a 400 Bad Request.
            log.error("Validation failed for CGL request {}: {}", request.getId(), violations);
            throw new ConstraintViolationException("CGL payload validation failed", violations);
        }
        log.info("Payload for CGL request {} passed validation.", request.getId());

        // Step 3: Map the validated DTO to the JPA entity
        CGLMaster cglMaster = mapDtoToEntity(payloadDto);

        // Step 4: Save the valid entity to the master table
        cglMasterRepository.save(cglMaster);
        log.info("Successfully saved CGL master data for request ID: {}", request.getId());
    }

    private CGLMaster mapDtoToEntity(CglPayloadDto dto) {
        CGLMaster entity = new CGLMaster();
        entity.setComp1(dto.getComp1());
        entity.setSegmentCode(dto.getSegmentCode());
        entity.setComp2(dto.getComp2());
        entity.setDescription(dto.getDescription());
        entity.setAcClassification(dto.getAcClassification());
        entity.setBalFwd(dto.getBalFwd());
        entity.setDefBalType(dto.getDefBalType());
        entity.setStatus(dto.getStatus());
        entity.setBalCompare(dto.getBalCompare());
        entity.setManualPosting(dto.getManualPosting());
        // We DO NOT set cglNumber or openDate, as the database handles them.
        return entity;
    }
}


















