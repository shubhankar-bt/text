                        <FormInput name={`addDurYear${cat.id}`} value={formData[`addDurYear${cat.id}`] || ''} onChange={handleInputChange} onBlur={handleInputBlur} disabled={isDisabled} />
                    </TableCell>
                  </TableRow>
                  <TableRow hover>
                    <TableCell></TableCell>
                    <TableCell>Deductions during the year</TableCell>
                    <TableCell align="right">
                        <FormInput name={`dedDurYear${cat.id}`} value={formData[`dedDurYear${cat.id}`] || ''} onChange={handleInputChange} onBlur={handleInputBlur} disabled={isDisabled} />
                    </TableCell>
                  </TableRow>
                </Fragment>
              ))}
              <TableRow hover>
                <TableCell><Typography variant="body1" fontWeight="bold">VII.</Typography></TableCell>
                [span_21](start_span)<TableCell><Typography variant="body1" fontWeight="bold">BALANCE OF PROFIT AND LOSS A/C</Typography></TableCell> {/*[span_21](end_span) */}
                <TableCell align="right">
                    <FormInput name="currYearBal8" value={formData.currYearBal8 || '0.00'} readOnly />
                </TableCell>
              </TableRow>
              <TableRow hover>
                <TableCell></TableCell>
                <TableCell><Typography variant="h6">TOTAL RESERVES & SURPLUS</Typography></TableCell>
                <TableCell align="right">
                    <FormInput name="currYearBal9" value={formData.currYearBal9 || '0.00'} readOnly />
                </TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </Box>
      </Box>

      <ValidationErrorDialog open={errors.length > 0} onClose={() => setErrors([])} errors={errors} />

      <ActionModal
        open={modalState.open}
        handleClose={() => setModalState({ ...modalState, open: false })}
        title={modalState.title}
        messages={modalState.messages}
        actions={modalState.actions}
      />
    </>
  );
};

export default Schedule2;
