import { useState, useEffect, useCallback, useMemo } from 'react';
import { Typography, Table, TableBody, TableCell, TableHead, TableRow, Box, Card, Container } from '@mui/material';
import ActionModal from './components/ActionModal';
import ReserveCategory from './components/ReserveCategory';
import FormInput from '../../../../common/components/ui/FormInput';
import { CustomButton } from '../../../../common/components/ui/Buttons';
import { useLocation, useNavigate } from 'react-router-dom';
import { api } from './components/apiServices';
import useApi from '../../../../common/hooks/useApi';
import SkeletonWrapper from '../../../../common/components/ui/SkeletonWrapper';
import ValidationErrorDialog from './components/ValidationErrorDialog';
import useCustomSnackbar from '../../../../common/hooks/useCustomSnackbar';

const parseFloatSafe = (value) => {
  const num = parseFloat(value);
  return isNaN(num) ? 0 : num;
};

const Schedule2 = () => {
  // const [formData, setFormData] = useState(initialFormData);
  const [formData, setFormData] = useState(null);

  const [isDirty, setIsDirty] = useState(false);
  const [modalState, setModalState] = useState({ open: false, title: '', messages: [], actions: [] });
  const [errors, setErrors] = useState([]);
  // const [isLoading, setIsLoading] = useState(true);
  const location = useLocation();
  const navigate = useNavigate();
  const { callApi, loading: isLoading } = useApi();
  const sessionUser = JSON.parse(localStorage.getItem('user'));
  const reportObject = location?.state.report;
  const isDisabled = /* !(reportObject.status === 'Pending' || reportObject.status === null) */ false;
  const snackbar = useCustomSnackbar();

  const reserveCategories = useMemo(
    () => [
      { id: '', serial: 'I.', title: 'Statutory Reserves' },
      { id: '1', serial: 'II.', title: 'Capital Reserves' },
      { id: '2', serial: 'III.', title: 'Share Premium' },
      { id: '6', serial: 'IV.', title: 'Foreign currency Translation Reserve' },
      { id: '5', serial: 'V.', title: 'Revenue and Other Reserves*' },
      { id: '7', serial: 'VI.', title: 'Revaluation Reserve' },
    ],
    []
  );

  useEffect(() => {
    if (!reportObject) {
      navigate('../');
      return;
    }
    const fetchData = async () => {
      // This logic mimics the original controller's data fetching flow
      const prevYearParams = {
        circleCode: sessionUser.circleCode,
        previousYearEndDate: sessionUser.previousYearEndDate,
      };
      try {
        const prevYearData = await api.getPreDataTwo(prevYearParams, callApi);
        if (!prevYearData) {
          throw new Error();
        }
        let currentData = {};
        if (reportObject.status) {
          const currentYearParams = { circleCode: sessionUser.circleCode, quarterEndDate: sessionUser.quarterEndDate };
          currentData = await api.getDataTwo(currentYearParams, callApi);
        } else {
          const savedParams = { circleCode: sessionUser.circleCode, quarterEndDate: sessionUser.quarterEndDate };
          currentData = await api.getSavedDataTwo(savedParams, callApi);
        }
        if (Object.keys(currentData).length === 0) {
          throw new Error();
        }
        setFormData((prev) => ({ ...prev, ...prevYearData, ...currentData }));
      } catch (error) {
        if (error.code === 'ERR_CANCELED') {
          return;
        }
        setFormData(null);
        snackbar('Failed to load data!', 'error');
      }
    };
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleInputChange = useCallback((e) => {
    const { name, value } = e.target;
    setFormData((prevData) => ({ ...prevData, [name]: value }));
    setIsDirty(true);
  }, []);

  const handleInputBlur = useCallback((e) => {
    const { name, value } = e.target;
    if (value && value !== '') return;
    setFormData((prevData) => ({ ...prevData, [name]: '0.00' }));
    setIsDirty(true);
  }, []);

  const calculateTotals = useCallback(() => {
    if (!formData) return;
    const { Pyr, Pyr1, Pyr2, Pyr5, Pyr6, Pyr7, Pyr8 } = formData;
    const totalPyr9 = (
      parseFloatSafe(Pyr) +
      parseFloatSafe(Pyr1) +
      parseFloatSafe(Pyr2) +
      parseFloatSafe(Pyr5) +
      parseFloatSafe(Pyr6) +
      parseFloatSafe(Pyr7) +
      parseFloatSafe(Pyr8)
    ).toFixed(2);

    const { currYearBal, currYearBal1, currYearBal2, currYearBal5, currYearBal6, currYearBal7, currYearBal8 } =
      formData;
    const totalCurrYearBal9 = (
      parseFloatSafe(currYearBal) +
      parseFloatSafe(currYearBal1) +
      parseFloatSafe(currYearBal2) +
      parseFloatSafe(currYearBal5) +
      parseFloatSafe(currYearBal6) +
      parseFloatSafe(currYearBal7) +
      parseFloatSafe(currYearBal8)
    ).toFixed(2);

    setFormData((prev) => ({ ...prev, Pyr9: totalPyr9, currYearBal9: totalCurrYearBal9 }));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [isDirty]);

  useEffect(() => {
    calculateTotals();
  }, [
    formData?.Pyr,
    formData?.currYearBal,
    formData?.Pyr1,
    formData?.currYearBal1,
    formData?.Pyr2,
    formData?.currYearBal2,
    formData?.Pyr5,
    formData?.currYearBal5,
    formData?.Pyr6,
    formData?.currYearBal6,
    formData?.Pyr7,
    formData?.currYearBal7,
    formData?.Pyr8,
    formData?.currYearBal8,
    calculateTotals,
  ]);

  const validateAndSubmit = (e) => {
    e.preventDefault();

    const errors = reserveCategories
      .map((cat) => {
        const { id, title } = cat;
        const openBal = parseFloatSafe(formData[`openBal${id}`]);
        const addDurYear = parseFloatSafe(formData[`addDurYear${id}`]);
        const dedDurYear = parseFloatSafe(formData[`dedDurYear${id}`]);
        const currYearBal = parseFloatSafe(formData[`currYearBal${id}`]);
        const calculatedTotal = (openBal + addDurYear - dedDurYear).toFixed(2);

        if (calculatedTotal !== currYearBal.toFixed(2)) {
          return {
            particular: title,
            expected: currYearBal.toFixed(2),
            found: calculatedTotal,
          };
        }
        return null;
      })
      .filter(Boolean);

    if (errors.length > 0) {
      setErrors(errors);
      return;
    }

    if (!isDirty) {
      setModalState({
        open: true,
        title: 'Confirm Submission',
        messages: ["You haven't changed any data. Would you like to submit the report?"],
        actions: [
          {
            text: 'Yes',
            onClick: () => {
              setModalState({ ...modalState, open: false });
              performSubmit();
            },
            color: 'success',
          },
          { text: 'No', onClick: () => setModalState({ ...modalState, open: false }) },
        ],
      });
    } else {
      performSubmit();
    }
  };

  const handleRedirect = async () => {
    navigate('../');
  };

  const performSubmit = async () => {
    try {
      const submissionData = {
        ...formData,
        circleCode: sessionUser.circleCode,
        quarterEndDate: sessionUser.quarterEndDate,
        userId: sessionUser.userId,
        reportName: reportObject.name,
        reportId: reportObject.reportId,
        reportMasterId: reportObject.reportMasterId,
        status: reportObject.status,
      };
      if (sessionUser.capacity !== '61') {
        submissionData.areMocPending = reportObject.areMocPending;
      }

      // Show loading state here
      const response = await api.submitScrTwo(submissionData, callApi);
      // Hide loading state here

      if (response && response >= 1) {
        snackbar('Report Submitted Successfully!', 'success');
        handleRedirect();
      } else {
        throw new Error('Error submitting the data!');
      }
    } catch (error) {
      console.log(error);
      if (error.code === 'ERR_CANCELED') {
        return;
      }
      snackbar('Error submitting the data!', 'error');
    }
  };

  if (isLoading) {
    return (
      <>
        <SkeletonWrapper
          isLoading={isLoading}
          skeletonType="table"
          skeletonConfig={{
            rows: 15,
            columns: 2,
            hasHeader: true,
            hasActions: false,
          }}
        />
      </>
    );
  }

  if (!isLoading && (!formData || Object.keys(formData).length === 0)) {
    return (
      <Container maxWidth="xl" sx={{ mt: 4, mb: 4 }}>
        <Typography variant="h6" align="center">
          Failed to load Schedule 2 Data!
        </Typography>
      </Container>
    );
  }

  return (
    <>
      <Box sx={{ width: '100%' }}>
        <Box component={'form'} onSubmit={validateAndSubmit}>
          <Box sx={{ mb: 1 }}>
            <CustomButton label={'Submit'} buttonType={'submit'} /* disabled={isDisabled} */ type="submit">
              Submit
            </CustomButton>
          </Box>
          <Table component={Card} sx={{ p: 0 }}>
            <TableHead>
              <TableRow>
                <TableCell>
                  <b>Sr. No.</b>
                </TableCell>
                <TableCell>
                  <b>Particulars</b>
                </TableCell>
                <TableCell align="center">
                  <b>Previous Year Balance as on {sessionUser.previousYearEndDate}</b>
                </TableCell>
                <TableCell align="center">
                  <b>Current Year Balance as on {sessionUser.quarterEndDate}</b>
                </TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {reserveCategories.map((cat) => (
                <ReserveCategory
                  key={cat.id}
                  serial={cat.serial}
                  title={cat.title}
                  values={{
                    id: cat.id,
                    currYearBal: formData[`currYearBal${cat.id}`],
                    openBal: formData[`openBal${cat.id}`],
                    addDurYear: formData[`addDurYear${cat.id}`],
                    dedDurYear: formData[`dedDurYear${cat.id}`],
                    Pyr: formData[`Pyr${cat.id}`],
                    pyrOpenBal: formData[`pyrOpenBal${cat.id}`],
                    pyrAddDurYear: formData[`pyrAddDurYear${cat.id}`],
                    pyrDedDurYear: formData[`pyrDedDurYear${cat.id}`],
                  }}
                  handleChange={handleInputChange}
                  handleInputBlur={handleInputBlur}
                  disabled={isDisabled}
                />
              ))}
              {/* Balance of Profit and Loss */}
              <TableRow hover>
                <TableCell>
                  <Typography variant="body1" fontWeight="bold">
                    VII.
                  </Typography>
                </TableCell>
                <TableCell>
                  <Typography variant="body1" fontWeight="bold">
                    BALANCE OF PROFIT AND LOSS A/C
                  </Typography>
                </TableCell>
                <TableCell align="right">
                  <FormInput name="Pyr8" value={formData.Pyr8} readOnly />
                </TableCell>
                <TableCell align="right">
                  <FormInput name="currYearBal8" value={formData.currYearBal8} readOnly />
                </TableCell>
              </TableRow>

              {/* Total Reserves */}
              <TableRow hover>
                <TableCell></TableCell>
                <TableCell>
                  <Typography variant="h6">TOTAL RESERVES & SURPLUS</Typography>
                </TableCell>
                <TableCell align="right">
                  <FormInput name="Pyr9" value={formData.Pyr9} readOnly />
                </TableCell>
                <TableCell align="right">
                  <FormInput name="currYearBal9" value={formData.currYearBal9} readOnly />
                </TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </Box>
      </Box>

      <ValidationErrorDialog open={errors.length !== 0} onClose={() => setErrors([])} errors={errors} />

      <ActionModal
        open={modalState.open}
        handleClose={() => setModalState({ ...modalState, open: false })}
        title={modalState.title}
        messages={modalState.messages}
        actions={modalState.actions}
        titleColor={modalState.titleColor}
      />
    </>
  );
};

