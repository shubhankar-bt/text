app.controller('T62Controller', function ($scope, $rootScope, $timeout, AES256, $state, T62Factory, $sessionStorage,frReturnFactory, blockUI) {

    let T62 = this;
    $scope.started = false;
    $scope.change = 0;
    $scope.sessionUser = JSON.parse(AES256.decrypt($rootScope.globals.currentUser));
    let qed = $scope.sessionUser.quarterEndDate;
    let userId = $scope.sessionUser.userId;
    let status = sessionStorage.getItem("frReportSts");
    let reportId = sessionStorage.getItem("frReportId");
    T62.reportName = sessionStorage.getItem("frSubReportName");
    T62.srno = {};
    T62.editable = {};
    $scope.T62ListOfRows = [];
    let idList = [];

    T62.inputChange = function () {
        $scope.change = 1;
    }

    T62.parseFloat = function (value) {
        if (isNaN(value)) {
            value = 0;
        }
        return parseInt(value * 1);
    }

    var {passphrase, iv, salt, aesUtil} = encryptValues($scope, AES256, $rootScope);

    $('.modal-backdrop').remove();
    $('body').removeClass("modal-open");

    var rmlParams = {
        'qed': qed,
        'userId': userId,
        'rMId': "40023602"
    }


    T62.checkAmount62 = function (numVal) {

        let amt = String($('#' + numVal).val());
        if (amt != 0 || amt != 0.00) {
            amt = document.getElementById(numVal).value = (document.getElementById(numVal).value).replaceAll(" ", "");
            amt = amt.replace(/^0+/, "");
        }
        if (isNaN(amt)) {
            alert("Please enter Numeric Value only");
            $('#' + numVal).val("")
            $('#' + numVal).focus();
            return false;
        }
        let c = /^(?:\-?\d{1,15}\.\d{1,2}|\-?\d{1,15})$/;
        if (c.test(amt) || amt === "") {
            let idot = amt.indexOf('.');
            if (idot === -1) {
                if (amt === "") {
                    $('#' + numVal).val(amt.concat("0.00"));
                } else if (('#' + numVal == "val2") || ('#' + numVal == "val4") || ('#' + numVal == "val7")) {
                    $('#' + numVal).val(Math.trunc($('#' + numVal).val()));
                } else {
                    $('#' + numVal).val(amt.concat(".00"));
                }
            } else if (('#' + numVal == "val2") || ('#' + numVal == "val4") || ('#' + numVal == "val7")) {
                $('#' + numVal).val(Math.trunc($('#' + numVal).val()));
            } else if (idot !== -1 && amt.charAt(idot + 2) === "") {
                $('#' + numVal).val(amt.concat("0"));
            }
        } else {
            alert("Amount is not allowed more than 15 digits and two decimal digits.");
            $('#' + numVal).val("");
            $('#' + numVal).focus();
            return false;
        }

        return true;
    }


    if (status == '' || status.length == 0 || status == null) {
        T62Factory.rmlEntry(rmlParams).then(function (data) {
            T62.reportId = reportId = data.split(":")[0];
            status = data.split(":")[1];
            if (status > 10) {
                var param = {
                    'reportId': reportId,
                    'qed': qed
                }
                T62Factory.getSavedData(param).then(function (data) {

                    data.forEach(function (s) {
                        $scope.T62ListOfRows.push(s);
                        T62.srno = T62.srno + ":" + s.srno;
                        T62.editable = T62.editable + ":" + s.editable;
                    });
                    setTimeout(function () {
                        for (let i = 1; i <= data.length; i++) {
                            document.getElementById('value1' + T62.srno.split(':')[i]).disabled = true;
                            document.getElementById('value2' + T62.srno.split(':')[i]).disabled = true;
                            document.getElementById('value3' + T62.srno.split(':')[i]).disabled = true;
                            document.getElementById('save' + T62.srno.split(':')[i]).disabled = true;
                            document.getElementById('edit' + T62.srno.split(':')[i]).disabled = false;
                            if (T62.editable.split(':')[i] == 'N') {
                                document.getElementById('delete' + T62.srno.split(':')[i]).disabled = true;
                            } else {
                                document.getElementById('delete' + T62.srno.split(':')[i]).disabled = false;
                            }
                        }
                    }, 1);
                }, function (errorResponse) {
                    console.log('Error while getting saved data.' );
                });
            }


        }, function (errorResponse) {
            console.log('Error while rml Insert.' );
        });
    } else {
        T62Factory.getRml(rmlParams).then(function (data) {
            T62.reportId = data;
            if (status > 10) {
                var param = {
                    'reportId': reportId,
                    'qed': qed
                }
                T62Factory.getSavedData(param).then(function (data) {
                    data.forEach(function (s) {
                        $scope.T62ListOfRows.push(s);
                        T62.srno = T62.srno + ":" + s.srno;
                        T62.editable = T62.editable + ":" + s.editable;
                    });
                    setTimeout(function () {
                        for (let i = 1; i <= data.length; i++) {

                            document.getElementById('value1' + T62.srno.split(':')[i]).disabled = true;
                            document.getElementById('value2' + T62.srno.split(':')[i]).disabled = true;
                            document.getElementById('value3' + T62.srno.split(':')[i]).disabled = true;
                            document.getElementById('save' + T62.srno.split(':')[i]).disabled = true;
                            document.getElementById('edit' + T62.srno.split(':')[i]).disabled = false;
                            if (T62.editable.split(':')[i] == 'N') {
                                document.getElementById('delete' + T62.srno.split(':')[i]).disabled = true;
                            } else {
                                document.getElementById('delete' + T62.srno.split(':')[i]).disabled = false;
                            }
                        }
                    }, 1);
                }, function (errorResponse) {
                    console.log('Error while getting saved data.' );
                });
            }
        }, function (errorResponse) {
            console.log('Error while rml fetching.' );
        });
    }


    $scope.addT62Row = function () {
        var rowID;
        T62Factory.getReportId().then(function (data) {
            rowID = data;

            if (rowID != null || rowID != undefined) {
                blockUI.start();
                $scope.T62ListOfRows.push({
                    'srno': rowID,
                    'insertedVal1': $scope.insertedVal1,
                    'insertedVal2': $scope.insertedVal2,
                    'insertedVal3': $scope.insertedVal3,
                });
                blockUI.stop();
            }

        }, function (errResponse) {
            console.error('Error while getting rowId +' + errResponse);
        });
    }


    T62.saveVal = function (amt1, amt2, amt3, rowId, dataFlag, index, editable) {

        if ((amt1 == "" || amt1 == null) && (amt2 == "" || amt2 == null) && (amt3 == null || amt3 == "")) {
            alert('Please enter some data to save row.');
        } else if ($scope.change == 0) {
            alert('No modifications to save!');
        } else if ((amt1 == "" || amt1 == null) || (amt2 == "" || amt2 == null) || (amt3 == null || amt3 == "")) {
            alert('All fields are mandatory.');
        } else {
            let dataFlag1 = $('#dataFlag' + rowId).val();
            let key = (parseInt(rowId)).toString();
            let T62_DESC = amt1;
            let T62_DEE_CY = amt2;
            let T62_AEE_CY = parseFloat(amt3);
            let reportId = T62.reportId.toString();
            let params = {
                'reportId1': aesUtil.encrypt(salt, iv, passphrase, reportId),
                'key': aesUtil.encrypt(salt, iv, passphrase, key),
                'salt': salt,
                'iv': iv,

                'value1': aesUtil.encrypt(salt, iv, passphrase, T62_DESC.toString()),
                'value2': aesUtil.encrypt(salt, iv, passphrase, T62_DEE_CY.toString()),
                'value3': aesUtil.encrypt(salt, iv, passphrase, T62_AEE_CY.toString()),
                'value4': aesUtil.encrypt(salt, iv, passphrase, qed.toString()),
                'value5': aesUtil.encrypt(salt, iv, passphrase, dataFlag1.toString()),
            }

            T62Factory.saveRow(params).then(function (data) {
                if (data) {
                    $('#dataFlag' + index).val('U');
                    $('#save' + rowId).prop('disabled', true);
                    $('#edit' + rowId).prop('disabled', false);
                    if (editable == 'N') {
                        $('#delete' + rowId).prop('disabled', true);
                    } else {
                        $('#delete' + rowId).prop('disabled', false);
                    }
                    $('#value1' + rowId).prop('disabled', true);
                    $('#value2' + rowId).prop('disabled', true);
                    $('#value3' + rowId).prop('disabled', true);
                }
            }, function (errResponse) {
                console.log('Error response for saveRow' );
            })
        }

    }

    T62.editRow = function (rowId, editable) {
        $('#dataFlag' + rowId).val('U');
        $('#save' + rowId).prop('disabled', false);
        $('#edit' + rowId).prop('disabled', true);

        if (editable == 'N') {
            $('#value1' + rowId).prop('disabled', true);
            $('#delete' + rowId).prop('disabled', true);
        } else {
            $('#value1' + rowId).prop('disabled', false);
            $('#delete' + rowId).prop('disabled', false);
        }
        $('#value2' + rowId).prop('disabled', false);
        $('#value3' + rowId).prop('disabled', false);
    }

    T62.deleteRow = function (rowId, index) {
        var params = {
            'rowId': rowId,
            'reportId': reportId,
            'qed': qed
        }

        T62Factory.deleteRow(params).then(function (data) {
            if (data) {
                $scope.T62ListOfRows.splice(index, 1);
            }
        }, function (errResponse) {
            console.log('Error response for deleteRow' );
        });

    }
    T62.submitIndividual = function (){
        let params = {
            // 'reportId' :  T62.reportId.toString(),
            'reportId': aesUtil.encrypt(salt, iv, passphrase, T62.reportId.toString()),
            'salt': salt,
            'iv': iv,
            'qed': qed,

        };
        frReturnFactory.submitIndividual(params).then(function (data){
            console.log("data-"+data);
            if(data==1){
                T62.displayMessage = T62.reportName +" report has been submitted successfully.";
                console.log(T62.displayMessage);
                $('#modalSubmit').modal({
                    backdrop: 'static',
                    keyboard: false,
                    modal: true
                });
                $('#modalSubmit').on('shown.bs.modal', function () {
                    $('#modalSubmit').trigger('focus');
                });
            }
            //modal
        }, function (errResponse){
            console.error('Submit individual failed. '+errResponse);
        })
    }

    T62.redirectToFRReturn = function () {
        $timeout(function () {
            $state.go('frt_maker.frReturn');
            // $state.reload();
        }, 500);
    }


});




