        /*function to check number in text boxes
        @Author V1014061*/
        function checkNumber(numVal) {
            console.log("into check num fn" + numVal);

            var val = document.getElementById(numVal).value;
            console.log("val- " + val);

            var len = val.length;
            console.log("len ::" + len);

            if (isNaN(val)) {
                alert("Please enter Numeric Value only");
                document.getElementById(numVal).value = "";
                document.getElementById(numVal).focus();
                return false;
            }

            if (len > 16) {
                alert("the number should not exceed 16 digits");
                document.getElementById(numVal).value = "";
                document.getElementById(numVal).focus();
                return false;
            }

            if (val.match(/\+/g)) {
                alert("+ is not allowed");
                document.getElementById(numVal).value = "";
                document.getElementById(numVal).focus();
                return false;
            }

            if (val.match(/\-/g)) {
                alert("- is not allowed");
                document.getElementById(numVal).value = "";
                document.getElementById(numVal).focus();
                return false;
            }

            if (val.match(/\s/g)) {
                alert("Space is not allowed");
                document.getElementById(numVal).value = "";
                document.getElementById(numVal).focus();
                return false;
            }

            if (val.match(/\e/g)) {
                alert("e is not allowed");
                document.getElementById(numVal).value = "";
                document.getElementById(numVal).focus();
                return false;
            }

            if (val.includes(".")) {
                var decimal = val.split('.')[1];
                var len = decimal.length;
                if (len > 2) {
                    alert("only 2 decimal digits are allowed");
                    document.getElementById(numVal).value = "";
                    document.getElementById(numVal).focus();
                }
            }

            var c = /^(?:\-?\d{1,16}\.\d{1,2}|\-?\d{1,16})$/;

            if (c.test(val) || val == "") {
                console.log("in if of check c");
                var idot = val.indexOf('.');
                console.log("idot 2 zero append:-   " + idot);
                if (idot == -1) {
                    console.log("idot 2 zero append:-");
                    if (val == "") {
                        console.log("into blank amount append 0.00");
                        document.getElementById(numVal).value = val.concat("0.00");
                    } else {
                        document.getElementById(numVal).value = val.concat(".00");
                        console.log("idot 2 zero append:-   " + idot + "val value:- " + val.concat(".00"))
                    }
                } else if (idot != -1 && val.charAt(idot + 2) == "") {
                    console.log("idot 1 zero append:-");
                    document.getElementById(numVal).value = val.concat("0");
                    console.log("idot 1 zero append:-   " + idot + "val value:- " + val.concat("0"))
                }
            }
            return true;
        }


