// --- Helper Functions ---

const parseToNumber = (value) => {
  const num = parseFloat(String(value).replace(/,/g, ''));
  return isNaN(num) ? 0 : num;
};

const validateAndFormatAmount = (value) => {
  const trimmedValue = String(value).trim();
  if (trimmedValue === '') return { isValid: true, value: '0.00', error: null };
  if (/[+\-e\s]/g.test(trimmedValue)) return { isValid: false, value, error: 'Invalid characters in number.' };
  
  const regex = /^\d{1,16}(\.\d{1,2})?$/;
  if (!regex.test(trimmedValue)) {
    return {
      isValid: false,
      value,
      error: 'Amount cannot exceed 16 digits and 2 decimal places.',
    };
  }

  let formattedValue = trimmedValue;
  if (!formattedValue.includes('.')) {
    formattedValue += '.00';
  } else if (formattedValue.split('.')[1].length === 1) {
    formattedValue += '0';
  }
  return { isValid: true, value: formattedValue, error: null };
};

const validateAndFormatCount = (value) => {
    const trimmedValue = String(value).trim();
    if (trimmedValue === '') return { isValid: true, value: '0', error: null };
    if (/[^0-9]/g.test(trimmedValue)) return { isValid: false, value, error: 'Borrower count must be a whole number.'};
    if (trimmedValue.length > 16) return { isValid: false, value, error: 'Number cannot exceed 16 digits.'}
    return {isValid: true, value: trimmedValue, error: null };
}

