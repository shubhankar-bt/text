package com.fincore.reportservice.model;

import jakarta.persistence.*;
import lombok.Getter;
import lombok.Setter;
import org.hibernate.annotations.CreationTimestamp;

import java.time.Instant;
import java.util.Set;

@Entity
@Table(name = "GLIF_REPORT_TYPES")
@Getter
@Setter
public class ReportType {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(name = "report_name", nullable = false, unique = true)
    private String reportName;

    @Column(name = "display_name", nullable = false)
    private String displayName;

    @CreationTimestamp
    @Column(name = "created_at", updatable = false)
    private Instant createdAt;

    // --- NEW MAPPING ---
    @ManyToMany(fetch = FetchType.LAZY)
    @JoinTable(
            name = "REPORT_ROLE_MAPPING",
            joinColumns = @JoinColumn(name = "report_type_id"),
            inverseJoinColumns = @JoinColumn(name = "role_id")
    )
    private Set<Role> roles;
}










package com.fincore.reportservice.repository;

import com.fincore.reportservice.model.ReportType;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import java.util.List;
import java.util.Set;

@Repository
public interface ReportTypeRepository extends JpaRepository<ReportType, Long> {

    /**
     * Finds all report types and orders them by their display name for a better user experience.
     * @return A list of ReportType entities.
     */
    // This method is still useful for admins or internal tools.
    List<ReportType> findAllByOrderByDisplayNameAsc();

    /**
     * Finds all report types that are accessible by at least one of the given user roles.
     * This is the new method for the role-based dropdown.
     *
     * @param roleNames A set of role names (e.g., ["ROLE_GLIF_ANALYST", "ROLE_USER"])
     * @return A list of accessible ReportType entities, ordered by display name.
     */
    @Query("SELECT DISTINCT rt FROM ReportType rt JOIN rt.roles r WHERE r.roleName IN :roleNames ORDER BY rt.displayName ASC")
    List<ReportType> findByRoles(@Param("roleNames") Set<String> roleNames);
}













