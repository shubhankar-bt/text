package com.fincore.reportservice.service.impl;

import com.fincore.reportservice.dto.ReportTypeDto;
import com.fincore.reportservice.exception.ReportNotFoundException;
import com.fincore.reportservice.repository.ReportTypeRepository;
import com.fincore.reportservice.service.ReportService;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.io.Resource;
import org.springframework.core.io.UrlResource;
import org.springframework.stereotype.Service;
import org.springframework.util.CollectionUtils;

import java.net.MalformedURLException;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.Collections;
import java.util.List;
import java.util.Set;
import java.util.stream.Collectors;

@Service
public class ReportServiceImpl implements ReportService {

    private static final Logger logger = LoggerFactory.getLogger(ReportServiceImpl.class);
    private final ReportTypeRepository reportTypeRepository;
    private final Path fileStorageLocation;

    public ReportServiceImpl(ReportTypeRepository reportTypeRepository, @Value("${glif.reports.base-path}") String basePath) {
        this.reportTypeRepository = reportTypeRepository;
        this.fileStorageLocation = Paths.get(basePath).toAbsolutePath().normalize();
        logger.info("Report storage location initialized at: {}", this.fileStorageLocation);
    }

    @Override
    public List<ReportTypeDto> getReportTypes(Set<String> userRoles) {
        if (CollectionUtils.isEmpty(userRoles)) {
            logger.warn("getReportTypes called with no user roles. Returning empty list.");
            return Collections.emptyList();
        }
        logger.info("Fetching GLIF report types for roles: {}", userRoles);
        return reportTypeRepository.findByRoles(userRoles).stream()
                .map(reportType -> new ReportTypeDto(reportType.getReportName(), reportType.getDisplayName()))
                .collect(Collectors.toList());
    }
    
    // getReport method remains unchanged
    @Override
    public Resource getReport(String reportName, LocalDate date) {
        // ... (The implementation from the previous response is still valid)
        try {
            String dateString = date.format(DateTimeFormatter.ISO_LOCAL_DATE);
            String filename = reportName + ".xlsx"; 
            Path targetPath = this.fileStorageLocation.resolve(dateString).resolve(filename);

            logger.info("Attempting to load report from path: {}", targetPath);
            Resource resource = new UrlResource(targetPath.toUri());

            if (resource.exists() && resource.isReadable()) {
                logger.info("Report found and is readable.");
                return resource;
            } else {
                logger.error("Report not found or is not readable at path: {}", targetPath);
                throw new ReportNotFoundException("Report not found for date: " + dateString + " and type: " + reportName);
            }
        } catch (MalformedURLException ex) {
            logger.error("Malformed URL exception for report: {} on date: {}", reportName, date, ex);
            throw new ReportNotFoundException("Could not read report file due to a path error.");
        }
    }
}












