package com.fincore.reportservice.service.impl;

import com.fincore.reportservice.dto.ReportTypeDto;
import com.fincore.reportservice.exception.ReportNotFoundException;
import com.fincore.reportservice.repository.ReportTypeRepository;
import com.fincore.reportservice.service.ReportService;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.io.Resource;
import org.springframework.core.io.UrlResource;
import org.springframework.security.access.AccessDeniedException;
import org.springframework.stereotype.Service;

import java.net.MalformedURLException;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.List;
import java.util.Set;
import java.util.stream.Collectors;

/**
 * Service implementation for handling business logic related to GLIF reports.
 */
@Service
public class ReportServiceImpl implements ReportService {

    private static final Logger logger = LoggerFactory.getLogger(ReportServiceImpl.class);

    private final ReportTypeRepository reportTypeRepository;
    private final Path fileStorageLocation;

    /**
     * Constructor for ReportServiceImpl.
     * Dependencies are injected by Spring.
     *
     * @param reportTypeRepository The repository for database operations on ReportType entities.
     * @param basePath             The base file path for reports, injected from application.properties.
     */
    public ReportServiceImpl(ReportTypeRepository reportTypeRepository,
                             @Value("${glif.reports.base-path}") String basePath) {
        this.reportTypeRepository = reportTypeRepository;

        // Normalize the base path to resolve ".." and ensure it's an absolute path.
        // This is a security and reliability best practice.
        this.fileStorageLocation = Paths.get(basePath).toAbsolutePath().normalize();
        logger.info("Report storage location has been initialized at: {}", this.fileStorageLocation);
    }

    /**
     * Retrieves a list of report types that are explicitly mapped to the given roleId.
     *
     * @param roleId The ID of the user's role.
     * @return A list of DTOs representing the available reports.
     */
    @Override
    public List<ReportTypeDto> getReportTypes(Long roleId) {
        if (roleId == null || roleId <= 0) {
            throw new IllegalArgumentException("Role ID must be a positive number.");
        }
        logger.info("Fetching GLIF report types for roleId: {}", roleId);

        // Call the new repository method to find reports by the role's primary key.
        return reportTypeRepository.findByRoleId(roleId).stream()
                // Convert the JPA entities to DTOs for the API response.
                .map(reportType -> new ReportTypeDto(reportType.getReportName(), reportType.getDisplayName()))
                .collect(Collectors.toList());
    }

    /**
     * Retrieves a report file after performing a critical authorization check.
     *
     * @param reportName The unique name of the report.
     * @param date The date for which to fetch the report.
     * @param userRoleIds The set of role IDs assigned to the current user.
     * @return The report file as a Spring Resource.
     * @throws AccessDeniedException if the user's roles do not grant access to the requested report.
     * @throws ReportNotFoundException if the report file does not exist on the file system.
     */
    @Override
    public Resource getReport(String reportName, LocalDate date, Set<Long> userRoleIds) {
        // --- SECURITY CHECK ---
        // Before touching the file system, verify that the user is allowed to access this report type.
        // This prevents unauthorized users from even checking for the existence of a file.
        reportTypeRepository.findByNameAndUserRoles(reportName, userRoleIds)
                .orElseThrow(() -> {
                    logger.warn("ACCESS DENIED: User with roles {} attempted to download unauthorized report '{}'", userRoleIds, reportName);
                    return new AccessDeniedException("You do not have permission to access the report: " + reportName);
                });

        logger.info("Authorization successful for report '{}'. Proceeding to file system.", reportName);

        try {
            // Construct the full path to the report file.
            // Path: {base-path}/{yyyy-MM-dd}/{reportName}.xlsx
            String dateString = date.format(DateTimeFormatter.ISO_LOCAL_DATE);
            String filename = reportName + ".xlsx"; // Assuming reports are always Excel files.
            Path targetPath = this.fileStorageLocation.resolve(dateString).resolve(filename);

            logger.info("Attempting to load report file from path: {}", targetPath);

            Resource resource = new UrlResource(targetPath.toUri());

            // Check if the file actually exists and is readable.
            if (resource.exists() && resource.isReadable()) {
                logger.info("Report file found and is readable.");
                return resource;
            } else {
                logger.error("Report file not found or is not readable at path: {}", targetPath);
                throw new ReportNotFoundException("Report not found for date: " + dateString + " and type: " + reportName);
            }
        } catch (MalformedURLException ex) {
            // This exception typically occurs if the constructed path is invalid.
            logger.error("Malformed URL exception for report: {} on date: {}. Check file path configuration.", reportName, date, ex);
            throw new ReportNotFoundException("Could not read report file due to a file path configuration error.");
        }
    }
}





