-- Map reports to roles
-- NOTE: We are using subqueries to get IDs based on names, which is more robust.
-- 'balance_compare_report' is available to ANALYST and MANAGER
INSERT INTO REPORT_ROLE_MAPPING (report_type_id, role_id) VALUES
((SELECT id FROM GLIF_REPORT_TYPES WHERE report_name = 'balance_compare_report'), (SELECT id FROM APP_ROLES WHERE role_name = 'ROLE_GLIF_ANALYST'));
INSERT INTO REPORT_ROLE_MAPPING (report_type_id, role_id) VALUES
((SELECT id FROM GLIF_REPORT_TYPES WHERE report_name = 'balance_compare_report'), (SELECT id FROM APP_ROLES WHERE role_name = 'ROLE_GLIF_MANAGER'));
-- 'cntr_report' is available only to ANALYST
INSERT INTO REPORT_ROLE_MAPPING (report_type_id, role_id) VALUES
((SELECT id FROM GLIF_REPORT_TYPES WHERE report_name = 'cntr_report'), (SELECT id FROM APP_ROLES WHERE role_name = 'ROLE_GLIF_ANALYST'));
-- 'intr_report' is available only to MANAGER
INSERT INTO REPORT_ROLE_MAPPING (report_type_id, role_id) VALUES
((SELECT id FROM GLIF_REPORT_TYPES WHERE report_name = 'intr_report'), (SELECT id FROM APP_ROLES WHERE role_name = 'ROLE_GLIF_MANAGER'));
