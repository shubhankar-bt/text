-- Table to store the menu items in a hierarchical structure
CREATE TABLE T_MENU_ITEMS (
    ID NUMBER(19) NOT NULL,
    TITLE VARCHAR2(255) NOT NULL,
    ICON VARCHAR2(255),
    ROUTE VARCHAR2(255) NOT NULL,
    HAS_CHILDREN NUMBER(1) DEFAULT 0 NOT NULL,
    SCREEN_ID VARCHAR2(255),
    SCREEN_TITLE VARCHAR2(255),
    SCREEN_ROUTE VARCHAR2(255),
    PARENT_ID NUMBER(19), -- Self-referencing key for hierarchy
    PRIMARY KEY (ID),
    CONSTRAINT FK_MENU_PARENT FOREIGN KEY (PARENT_ID) REFERENCES T_MENU_ITEMS(ID)
);

-- Sequence for generating primary keys for T_MENU_ITEMS
CREATE SEQUENCE MENU_ITEMS_SEQ START WITH 1 INCREMENT BY 1;


-- Table to store user roles
CREATE TABLE T_ROLES (
    ID NUMBER(19) NOT NULL,
    ROLE_NAME VARCHAR2(255) NOT NULL UNIQUE,
    PRIMARY KEY (ID)
);

-- Sequence for generating primary keys for T_ROLES
CREATE SEQUENCE ROLES_SEQ START WITH 1 INCREMENT BY 1;


-- Mapping table to grant menu access to roles (Many-to-Many)
CREATE TABLE T_ROLE_MENU_ACCESS (
    ROLE_ID NUMBER(19) NOT NULL,
    MENU_ITEM_ID NUMBER(19) NOT NULL,
    PRIMARY KEY (ROLE_ID, MENU_ITEM_ID),
    CONSTRAINT FK_ACCESS_ROLE FOREIGN KEY (ROLE_ID) REFERENCES T_ROLES(ID),
    CONSTRAINT FK_ACCESS_MENU FOREIGN KEY (MENU_ITEM_ID) REFERENCES T_MENU_ITEMS(ID)
);





