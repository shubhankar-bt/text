-- Table to store the menu items in a hierarchical structure
CREATE TABLE T_MENU_ITEMS (
    ID NUMBER(19) NOT NULL,
    TITLE VARCHAR2(255) NOT NULL,
    ICON VARCHAR2(255),
    ROUTE VARCHAR2(255) NOT NULL,
    HAS_CHILDREN NUMBER(1) DEFAULT 0 NOT NULL,
    SCREEN_ID VARCHAR2(255),
    SCREEN_TITLE VARCHAR2(255),
    SCREEN_ROUTE VARCHAR2(255),
    PARENT_ID NUMBER(19), -- Self-referencing key for hierarchy
    PRIMARY KEY (ID),
    CONSTRAINT FK_MENU_PARENT FOREIGN KEY (PARENT_ID) REFERENCES T_MENU_ITEMS(ID)
);

-- Sequence for generating primary keys for T_MENU_ITEMS
CREATE SEQUENCE MENU_ITEMS_SEQ START WITH 1 INCREMENT BY 1;


-- Table to store user roles
CREATE TABLE T_ROLES (
    ID NUMBER(19) NOT NULL,
    ROLE_NAME VARCHAR2(255) NOT NULL UNIQUE,
    PRIMARY KEY (ID)
);

-- Sequence for generating primary keys for T_ROLES
CREATE SEQUENCE ROLES_SEQ START WITH 1 INCREMENT BY 1;


-- Mapping table to grant menu access to roles (Many-to-Many)
CREATE TABLE T_ROLE_MENU_ACCESS (
    ROLE_ID NUMBER(19) NOT NULL,
    MENU_ITEM_ID NUMBER(19) NOT NULL,
    PRIMARY KEY (ROLE_ID, MENU_ITEM_ID),
    CONSTRAINT FK_ACCESS_ROLE FOREIGN KEY (ROLE_ID) REFERENCES T_ROLES(ID),
    CONSTRAINT FK_ACCESS_MENU FOREIGN KEY (MENU_ITEM_ID) REFERENCES T_MENU_ITEMS(ID)
);

























package com.yourcompany.menu.entity;

import jakarta.persistence.*;
import java.util.List;
import java.util.Set;

@Entity
@Table(name = "T_MENU_ITEMS")
public class MenuItem {

    @Id
    @GeneratedValue(strategy = GenerationType.SEQUENCE, generator = "menu_items_seq")
    @SequenceGenerator(name = "menu_items_seq", sequenceName = "MENU_ITEMS_SEQ", allocationSize = 1)
    private Long id;

    private String title;
    private String icon;
    private String route;
    private boolean hasChildren;

    // Embedded screen details
    private String screenId;
    private String screenTitle;
    private String screenRoute;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "PARENT_ID")
    private MenuItem parent;

    @OneToMany(mappedBy = "parent", fetch = FetchType.LAZY, cascade = CascadeType.ALL)
    private List<MenuItem> children;

    @ManyToMany(mappedBy = "accessibleMenuItems")
    private Set<Role> roles;

    // Getters and Setters...
}
















package com.yourcompany.menu.entity;

import jakarta.persistence.*;
import java.util.Set;

@Entity
@Table(name = "T_ROLES")
public class Role {

    @Id
    @GeneratedValue(strategy = GenerationType.SEQUENCE, generator = "roles_seq")
    @SequenceGenerator(name = "roles_seq", sequenceName = "ROLES_SEQ", allocationSize = 1)
    private Long id;

    private String roleName;

    @ManyToMany(fetch = FetchType.LAZY)
    @JoinTable(
        name = "T_ROLE_MENU_ACCESS",
        joinColumns = @JoinColumn(name = "ROLE_ID"),
        inverseJoinColumns = @JoinColumn(name = "MENU_ITEM_ID")
    )
    private Set<MenuItem> accessibleMenuItems;

    // Getters and Setters...
}










