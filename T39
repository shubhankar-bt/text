const parseToNumber = (value) => {
  if (value === null || typeof value === 'undefined') return 0;
  const num = parseFloat(String(value).replace(/,/g, ''));
  return isNaN(num) ? 0 : num;
};

const validateAndFormatAmount = (value) => {
  const trimmedValue = String(value).trim();
  if (trimmedValue === '') return { isValid: true, value: '0.00', error: null };
  if (/\s/g.test(trimmedValue)) return { isValid: false, value, error: 'Space is not allowed.' };

  const regex = /^(?:\-?\d{1,16}\.\d{1,2}|\-?\d{1,16})$/;
  if (!regex.test(trimmedValue)) {
    return {
      isValid: false,
      value,
      error: 'Amount cannot exceed 16 digits before the decimal and 2 digits after.',
    };
  }

  let formattedValue = trimmedValue.replace(/^0+/, "") || '0';
  if (formattedValue.startsWith('.')) formattedValue = '0' + formattedValue;
  if (!formattedValue.includes('.')) {
    formattedValue += '.00';
  } else if (formattedValue.split('.')[1].length === 1) {
    formattedValue += '0';
  }
  return { isValid: true, value: formattedValue, error: null };
};

const validateAndFormatPercentage = (value) => {
    const numericValue = String(value).replace('%','').trim();
    if(numericValue === '') return {isValid: true, value: '0.00%', error: null};

    if(isNaN(numericValue)){
        return {isValid: false, value, error: 'Percentage must be a numeric value.'}
    }
    const num = parseFloat(numericValue);
    if(num < 0 || num > 100){
        return {isValid: false, value, error: 'Percentage must be between 0 and 100.'}
    }
    const {value: formattedValue} = validateAndFormatAmount(numericValue);
    return {isValid: true, value: `${formattedValue}%`, error: null};
}


