app.controller('FRDiscAssetQualityController', function ($scope, $rootScope, $timeout, AES256, $state, FRDiscAssetFactory,frReturnFactory, $sessionStorage) {


    let FRDiscAsset = this;
    $scope.started = false;
    $scope.sessionUser = JSON.parse(AES256.decrypt($rootScope.globals.currentUser));
    let qed = $scope.sessionUser.quarterEndDate;
    let userId = $scope.sessionUser.userId;
    let status = sessionStorage.getItem("frReportSts");
    let reportId = sessionStorage.getItem("frReportId");
    FRDiscAsset.reportName = sessionStorage.getItem("frSubReportName");
    var {passphrase, iv, salt, aesUtil} = encryptValues($scope, AES256, $rootScope);
    FRDiscAsset.row="";
    $('.modal-backdrop').remove();
    $('body').removeClass("modal-open");
    FRDiscAsset.backToIndex = function () {
        $state.go('frt_maker.frReturn');
    }

    function updateOnLoad() {
        window.setTimeout(function () {
            FRDiscAsset.SaveData('Y040', FRDiscAsset.row.TBCODE5);
            FRDiscAsset.SaveData('Y060', FRDiscAsset.row.TBCODE7);
            FRDiscAsset.SaveData('Y070', FRDiscAsset.row.TBCODE8);
            FRDiscAsset.SaveData('Y110', FRDiscAsset.row.TBCODE12);
            FRDiscAsset.SaveData('Y120', FRDiscAsset.row.TBCODE14);
            FRDiscAsset.SaveData('Y150', FRDiscAsset.row.TBCODE17);
            FRDiscAsset.SaveData('Y160', FRDiscAsset.row.TBCODE19);
            FRDiscAsset.SaveData('Y190', FRDiscAsset.row.TBCODE22);
        }, 1000);
    }

// On Empty Status Insert Desc Inside Table
    FRDiscAsset.insertOrUpdate = function () {
        let params = {
            'qed': qed,
            'userId': userId,
            'rMId': "40022701"
        };

        // Checking RML Status
        if (status === null || status === '') {
            FRDiscAssetFactory.insertOnLoad(params).then(function (data) {
                sessionStorage.setItem("frReportId", data);
                window.setTimeout(function(){
                    reportId = sessionStorage.getItem("frReportId");
                    FRDiscAssetFactory.getDiscAssetQualityCYData(reportId).then(function (data) {
                        FRDiscAsset.row = data;
                        updateOnLoad();
                    }, function (errResponse) {
                        console.error('data failed. ' + errResponse);
                    })
                },1000);


            }, function (errResponse) {
                console.error('data not inserted. ' + errResponse);
            })
        } else {

            // Getting CY & PY Data From DB
            FRDiscAssetFactory.getDiscAssetQualityCYData(reportId).then(function (data) {
                FRDiscAsset.row = data;
                updateOnLoad();
            }, function (errResponse) {
                console.error('data failed. ' + errResponse);
            })
        }
    }

    // Setting 2 Decimal Digit
    FRDiscAsset.parseFloat = function (value) {
        if (isNaN(value)) {
            value = 0.00;
        }
        return (value * 1.00);
    }


    $scope.$watchCollection('FRDiscAsset.row', function (newValue, oldValue) {

        if (FRDiscAsset.row != undefined) { // Previous Year
            FRDiscAsset.row.PY7 = FRDiscAsset.parseFloat(parseFloat(FRDiscAsset.row.PY5) + parseFloat(FRDiscAsset.row.PY6)).toFixed(2);

            FRDiscAsset.row.PY8 = FRDiscAsset.parseFloat(parseFloat(FRDiscAsset.row.PY9) + parseFloat(FRDiscAsset.row.PY10) + parseFloat(FRDiscAsset.row.PY11)).toFixed(2);

            FRDiscAsset.row.PY12 = FRDiscAsset.parseFloat(FRDiscAsset.parseFloat(FRDiscAsset.row.PY7) - FRDiscAsset.parseFloat(FRDiscAsset.row.PY8)).toFixed(2);

            FRDiscAsset.row.CY4 = parseFloat(FRDiscAsset.row.PY12).toFixed(2);
            FRDiscAsset.row.PY17 = FRDiscAsset.parseFloat(FRDiscAsset.parseFloat(FRDiscAsset.row.PY14) + FRDiscAsset.parseFloat(FRDiscAsset.row.PY15) - FRDiscAsset.parseFloat(FRDiscAsset.row.PY16)).toFixed(2);


            FRDiscAsset.row.PY22 = FRDiscAsset.parseFloat(FRDiscAsset.parseFloat(FRDiscAsset.row.PY19) + FRDiscAsset.parseFloat(FRDiscAsset.row.PY20) - FRDiscAsset.parseFloat(FRDiscAsset.row.PY21)).toFixed(2);

            FRDiscAsset.row.CY7 = FRDiscAsset.parseFloat(FRDiscAsset.parseFloat(FRDiscAsset.row.CY4) + FRDiscAsset.parseFloat(FRDiscAsset.row.CY6)).toFixed(2);

            FRDiscAsset.row.CY8 = FRDiscAsset.parseFloat(FRDiscAsset.parseFloat(FRDiscAsset.row.CY9) + FRDiscAsset.parseFloat(FRDiscAsset.row.CY10) + FRDiscAsset.parseFloat(FRDiscAsset.row.CY11)).toFixed(2);

            FRDiscAsset.row.CY12 = FRDiscAsset.parseFloat(FRDiscAsset.parseFloat(FRDiscAsset.row.CY7) - FRDiscAsset.parseFloat(FRDiscAsset.row.CY8)).toFixed(2);

            FRDiscAsset.row.CY14 = FRDiscAsset.parseFloat(FRDiscAsset.row.PY17).toFixed(2);

            FRDiscAsset.row.CY17 = FRDiscAsset.parseFloat(FRDiscAsset.parseFloat(FRDiscAsset.row.CY14) + FRDiscAsset.parseFloat(FRDiscAsset.row.CY15) - FRDiscAsset.parseFloat(FRDiscAsset.row.CY16)).toFixed(2);

            FRDiscAsset.row.CY19 = FRDiscAsset.parseFloat(FRDiscAsset.row.PY22).toFixed(2);

            FRDiscAsset.row.CY22 = FRDiscAsset.parseFloat(FRDiscAsset.parseFloat(FRDiscAsset.row.CY19) + FRDiscAsset.parseFloat(FRDiscAsset.row.CY20) - FRDiscAsset.parseFloat(FRDiscAsset.row.CY21)).toFixed(2);
        }
    });


    // On-Change Saves Data
    FRDiscAsset.SaveData = function (thisElement, tbCode) {

            var value = document.getElementById(thisElement).value;
            if (thisElement == 'CY1' || thisElement == 'CY2') {

                console.log("Inside 111");

            } else {
                if(value == null || value== undefined || value==NaN)
                {
                    console.log("Inside NAN Save ")
                    return false;
                }
                value = parseFloat(document.getElementById(thisElement).value).toFixed(2).toString();
            }

            var params = {
                'value': aesUtil.encrypt(salt, iv, passphrase, value),
