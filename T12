    FR_SC08.checkAmountSC08 = function (numVal) {
        if (numVal == 2 || numVal == 11) {
            let amt = String(document.getElementById("val" + numVal).value);
            if (amt != 0 || amt != 0.00) {
                amt = amt.replace(/^0+/, "");
            }
            document.getElementById("val" + numVal).value = amt;
            if (amt.match(/\s/g)) {
                alert("Space is not allowed");
                document.getElementById("val" + numVal).value = "";
                document.getElementById("val" + numVal).focus();
                return false;
            }
            if (isNaN(amt)) {
                alert("Please enter Numeric Value only");
                document.getElementById("val" + numVal).value = "";
                document.getElementById("val" + numVal).focus();
                return false;
            }
            let c = /^(?:\-?\d{1,15}\.\d{1,2}|\-?\d{1,15})$/;
            if (c.test(amt) || amt === "") {
                let idot = amt.indexOf('.');
                if (idot === -1) {
                    if (amt === "") {
                        document.getElementById("val" + numVal).value = amt.concat("0.00");
                    } else if ((numVal == "val2") || (numVal == "val4") || (numVal == "val7")) {
                    } else {
                        document.getElementById('val' + numVal).value = amt.concat(".00");
                    }
                } else if ((numVal == "val2") || (numVal == "val4") || (numVal == "val7")) {
                } else if (idot !== -1 && amt.charAt(idot + 2) === "") {
                    document.getElementById('val' + numVal).value = amt.concat("0");
                }
            } else {
                alert("Amount is not allowed more than 15 digits and two decimal digits.");
                document.getElementById("val" + numVal).value = "";
                document.getElementById("val" + numVal).focus();
                return false;
            }

            return true;
        }

    }


