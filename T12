import { Box } from '@mui/material';
import { useCallback, useEffect, useState, useTransition } from 'react';
import { useLocation } from 'react-router-dom';
import useCustomSnackbar from '../../../../../common/hooks/useCustomSnackbar';
import useApi from '../../../../../common/hooks/useApi';
import { callInsertOnLoad, callFetchData, callUpdateField } from './InvestmentsAPI';
import FRReturnsReport from '../../components/FRReturnsReport';

const disabledFields = [0, 2, 3, 4, 5, 6, 7, 8, 9, 11, 12, 13, 14, 15];

export default function InvestmentsReport() {
  const user = JSON.parse(localStorage.getItem('user'));
  const { state } = useLocation();
  const report = state?.report;

  const [isLoading, setIsLoading] = useState(true);
  const [reportId, setReportId] = useState(report?.subReportFR_RID || null);
  const [rows, setRows] = useState(null);
  const [data, setData] = useState(null);
  const [, startTransition] = useTransition();

  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const saveField = useCallback(
    async (key, value) => {
      try {
        await callUpdateField(reportId.toString() ?? report?.subReportFR_RID, String(key), String(value), callApi);
      } catch (error) {
        if (error.code === 'ERR_CANCELED') {
          return;
        }
        console.log(error);
      }
    },
    [reportId, report, callApi]
  );

  const calculateTotals = useCallback((item, data) => {
    const newData = [...data];
    const total4 = Number(data[12]) + Number(data[13]) + Number(data[14]);
    const total3 = Number(data[10]) + total4;
    const total2 =
      Number(data[3]) +
      Number(data[4]) +
      Number(data[5]) +
      Number(data[6]) +
      Number(data[7]) +
      Number(data[8]) +
      Number(data[9]);
    const total1 = Number(data[1]) + total2;
    newData[0] = total1.toFixed(2);
    newData[2] = total2.toFixed(2);
    newData[9] = total3.toFixed(2);
    newData[11] = total4.toFixed(2);
    setData(newData);
  }, []);

  const handleCellChange = useCallback(
    (item, value) => {
      const newData = [...data];
      newData.splice(item?.dataIndex, 1, value);
      setData(newData);
      startTransition(() => {
        calculateTotals(item, newData);
      });
    },
    [data, calculateTotals]
  );

  const handleCellBlur = useCallback(
    (item, value) => {
      if (!item || disabledFields.includes(item.dataIndex)) return;
      const rowIndex = item.dataIndex + 1;
      saveField(rowIndex, value);
    },
    [saveField]
  );

  const processResponse = useCallback(async (response) => {
    const rows = [];
    const data = [];
    const isSubTitlePattern = /^[A-Z]+\. ?M{0,4}(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})\. /;
    const isSubSubTitlePattern = /^\d+ /;

    Object.entries(response).forEach(([, value]) => {
      const desc = value.SC08_DESC;
      const index = value.SC08_ID - 1;
      const isSubTitle = isSubTitlePattern.test(desc);
      const isSubSubTitle = isSubSubTitlePattern.test(desc);
      const indent = isSubTitle ? 3 : isSubSubTitle ? 6 : 0;
      rows.push([
        {
          title: desc,
          cellProps: {
            sx: {
              ml: indent,
            },
          },
        },
        {
          dataIndex: index,
          cellProps: {
            readOnly: disabledFields.includes(index),
          },
        },
      ]);
      data.push(String(value.SC08_VAL_CY));
    });
    setRows(rows);
    setData(data);
  }, []);

  useEffect(() => {
    setIsLoading(true);
    if (!report) return;
    const insertOnLoad = async () => {
      try {
        let response = await callInsertOnLoad(user.quarterEndDate, user.userId, report.subReportFR_RMID, callApi);
        if (response && Array.isArray(response) && response.length > 0) {
          const reportId = response[0].SC08_RPTID_FK;
          if (reportId) {
            setReportId(reportId);
            processResponse(response);
          }
        }
      } catch (error) {
        if (error.code === 'ERR_CANCELED') {
          return;
        }
        setData(null);
        snackbar('Failed to Fetch Data!', 'error');
        console.log('Report id generation error : ', error);
      }
      setIsLoading(false);
    };
    const fetchData = async () => {
      try {
        let response = await callFetchData(reportId ?? report.subReportFR_RID, callApi);
        if (response) {
          processResponse(response);
        }
      } catch (error) {
        if (error.code === 'ERR_CANCELED') {
          return;
        }
        setData(null);
        snackbar('Failed to Fetch Data!', 'error');
      }
      setIsLoading(false);
    };
    const init = async () => {
      try {
        const reportStatus = report.subReportStatus;
        if (reportStatus === null || reportStatus === '') {
          await insertOnLoad();
        } else {
          await fetchData();
        }
      } catch (error) {
        console.log(error);
        snackbar('Something went wrong!', 'error');
      }
    };
    init();
  }, []);

  return (
    <>
      <Box sx={{ mt: 2, mb: 4, width: '100%' }}>
        <FRReturnsReport
          reportId={reportId ?? reportId ?? report?.subReportFR_RID}
          qed={user.quarterEndDate}
          columns={[
            { title: 'Particulars', cellProps: {} },
            { title: 'Current Year', cellProps: {} },
          ]}
          rows={rows}
          data={data}
          onCellChange={handleCellChange}
          onCellBlur={handleCellBlur}
          isLoading={isLoading}
          completeButtonEnabled={true}
        />
      </Box>
    </>
  );
}

