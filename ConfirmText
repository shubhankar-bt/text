              label={'Confirm Selected'}
              disabled={selectedRequests.size === 0}
              // onClickHandler={onClickCreateUsers}
              onClickHandler={handleConfirmSelected}
            />
            <CustomButton
              buttonType={'delete'}
              label={'Delete Selected'}
              disabled={selectedRequests.size === 0}
              // onClickHandler={onClickDeleteRequests}
              onClickHandler={handleDeleteSelected}
            />
            <Button variant="outlined" color="secondary" onClick={onCancelSelect}>
              Exit Select Mode
            </Button>
          </>
        ) : (
          <Grid sx={{ display: 'flex', justifyContent: 'space-between', width: '100%' }}>
            <FormControlLabel
              control={<Android12Switch onClick={onToggleSelectMode} />}
              label="Select Mode"
              disabled={!requests.length}
              onMouseLeave={() => {
                setShowMessage(false);
              }}
              onMouseEnter={() => {
                setShowMessage(true);
              }}
            />
            <Stack
              direction="row"
              sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: 1 }}
            >
