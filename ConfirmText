        right: 12,
      },
    },
    '& .MuiSwitch-thumb': {
      boxShadow: 'none',
      width: 16,
      height: 16,
      margin: 2,
    },
  }));

  const loadData = useCallback(async () => {
    setLoading(true);
    try {
      setSelectedRequests(new Set());
      const requests = await getRequests(callApi);

      if (!requests) {
        setRequests([]);
        snackbar('Failed to Load Data!', 'error');
        return;
      }
      setRequests(requests);
    } catch (error) {
      console.log(error);
      if (error.code !== 'ERR_CANCELED') {
        setRequests([]);
        snackbar('Failed to Load Data!', 'error');
      }
    } finally {
      setLoading(false);
    }
