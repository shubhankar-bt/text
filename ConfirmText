                            select users and choose to confirm or delete them in bulk
                          </Typography>
                        </Typography>
                      </Fade>
                    }
                  />
                </Box>
              )}
            </Stack>
          </Grid>
        )}
      </Stack>
    );
  };

  if (loading) {
    return (
      <Stack direction={'row'} justifyContent={'center'}>
        <CircularProgress />
      </Stack>
    );
  }

  return (
    <Box component={Paper} elevation={2} sx={{ p: 3, minHeight: '100%' }}>
