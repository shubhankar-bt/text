import java.util.Map;

@RestController
@RequestMapping("/api/v1/requests")
@RequiredArgsConstructor
public class RequestController {

    private final RequestService requestService;

    // Example of how to get user details from a JWT token
    @PostMapping
    @ResponseStatus(HttpStatus.CREATED)
    public CommonReq createRequest(@RequestBody CreateRequestDto createRequestDto, @AuthenticationPrincipal Jwt jwt) throws JsonProcessingException {
        // The JWT filter you will add later will validate the token.
        // Spring Security's @AuthenticationPrincipal provides the decoded token.
        String userId = jwt.getSubject(); // Or jwt.getClaimAsString("userId");
        // String userRole = jwt.getClaimAsString("role");
        
