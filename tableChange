     * @param executorId The ID of the user performing the action.
     * @return An Optional containing the updated CommonReq if found and processed.
     * @throws JsonProcessingException if there is an issue processing the payload.
     */
    Optional<CommonReq> updateRequestStatus(ProcessRequestDto dto, String executorId) throws JsonProcessingException;

    List<CommonReq> getMyRequests(String userId, RequestType requestType);

    List<CommonReq> getPendingRequests();

    List<CommonReq> getAllRequests();
